// PFW data model.
//
// Security invariants that hold for every user-scoped model below (see
// AGENTS.md and docs/SECURITY.md for the full rationale):
//  - every user-owned row carries its own `userId` column directly (not
//    just via a parent relation), so the DAL can enforce `where: { userId }`
//    on any table without a join.
//  - Postgres Row-Level Security policies (prisma/migrations/*_rls_and_runtime_role)
//    enforce the same scoping as defense-in-depth, keyed on the session
//    variable `app.current_user_id`.
//  - fields marked "encrypted at rest" below are ciphertext (AES-256-GCM)
//    at the storage layer, transparently encrypted/decrypted by the Prisma
//    Client extension in src/server/db/encrypted-fields.ts — the schema
//    type is still String because encryption happens above this layer.
//
// MerchantEmbedding is user-scoped even though the spec calls it a "shared"
// cache — see AGENTS.md for why the more conservative (per-user) reading
// was chosen given the blanket "all tables are strictly scoped to a user
// ID" rule stated in the same spec section.
//
// ExchangeRate is the opposite deviation, deliberately NOT user-scoped —
// it holds no user data at all (public daily FX rates), so RLS/tenant
// scoping doesn't apply to it. See its own model comment.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Needed for the `extensions = [vector]` datasource declaration and
  // NotableTransaction.searchEmbedding's Unsupported("vector(384)") type
  // below (AGENTS.md §3cc) — verified against this exact installed
  // Prisma version (7.10.0) with `prisma validate` before committing to
  // this design, not assumed from general Prisma docs. `Unsupported`
  // fields have no typed Prisma Client read/write path regardless of
  // this flag — every actual read/write against searchEmbedding goes
  // through $queryRaw/$executeRaw (src/server/dal/transactions.ts).
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Declares the pgvector extension as part of this schema's contract —
  // `compose.yaml` now runs pgvector/pgvector:pg17 (a drop-in Postgres
  // 17 image with the extension's files installed) instead of the
  // plain postgres:17 image specifically so `CREATE EXTENSION vector`
  // (this migration's own SQL) has something to enable. See §3cc's k8s
  // note for why the CloudNativePG production manifest is NOT
  // equivalently updated in this pass — that image needs a custom
  // build this session couldn't verify against a live cluster.
  extensions = [vector]
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
}

enum DebtType {
  CREDIT_CARD
  MORTGAGE
  PERSONAL_LOAN
  AUTO_LOAN
  STUDENT_LOAN
  OTHER
}

enum AssetType {
  PROPERTY
  VEHICLE
  CRYPTO
  PENSION
  KEREN_HISHTALMUT
  OTHER
}

/// The Real-Time Liquidity Runway & Burn-Rate Engine's asset-classification
/// taxonomy (AGENTS.md §3v). LIQUID = spendable within days with no market
/// risk (bank checking/savings). SEMI_LIQUID = convertible to cash within
/// days-to-weeks but subject to market price risk (equities/crypto).
/// ILLIQUID = property, vehicles, retirement accounts with a real lock-in
/// (Keren Hishtalmut's 6-year window) — not realistically spendable during
/// a liquidity crunch. `BankAccount` and `PortfolioHolding` don't need
/// their own column for this: a bank account's `accountType` and the mere
/// fact of being a `PortfolioHolding` already unambiguously imply LIQUID
/// and SEMI_LIQUID respectively (src/lib/liquidity-classification.ts) —
/// only `ManualAsset` has a genuinely ambiguous default (its `assetType`
/// enum mixes clearly-illiquid PROPERTY/VEHICLE with a CRYPTO value that's
/// really semi-liquid), which is what `ManualAsset.liquidityTier` exists
/// to let a user override.
enum LiquidityTier {
  LIQUID
  SEMI_LIQUID
  ILLIQUID
}

enum TradeSide {
  BUY
  SELL
}

/// AGENTS.md §3k: multi-currency amendment to the original single-ILS law.
/// ILS remains the app's one base/reporting currency; the other three are
/// "native" currencies a BankAccount/NotableTransaction/PortfolioHolding/
/// Trade can be denominated in.
enum Currency {
  ILS
  USD
  EUR
  GBP
}

/// What kind of instrument a PortfolioHolding is. Drives the portfolio
/// module's allocation breakdown and, more importantly, dividend
/// expectations: CRYPTO never pays a dividend, so a zero yield there is
/// correct rather than missing data.
enum AssetClass {
  STOCK
  ETF
  CRYPTO
}

/// ANNOUNCED = declared but not yet paid (the upcoming-payout schedule);
/// PAID = money actually received. The distinction is what decides
/// whether the payout amount is *stored* (a historical fact) or *derived*
/// live from today's position — see the Dividend model comment.
enum DividendStatus {
  ANNOUNCED
  PAID
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// LedgerCommit never records DELETE — transactions are never deleted in
/// this app (no deleteTransaction DAL function exists), only created or
/// recategorized, so there are only ever two link types in the chain.
enum LedgerCommitAction {
  CREATE
  UPDATE
}

/// A SharedGroup member's standing. OWNER is exactly the group's creator
/// (there is only ever one — see `createSharedGroup`'s doc comment) and
/// always has implicit write access regardless of `permission`; every
/// other member is MEMBER, whose write access is governed by
/// `GroupMember.permission` alone.
enum GroupRole {
  OWNER
  MEMBER
}

/// Read = can see a resource shared into the group. Write = can also
/// edit it. Granted per-membership (one level per person per group), not
/// per-resource-per-person — see AGENTS.md §3s for why a full per-resource
/// ACL matrix was deliberately not built.
enum SharePermission {
  READ
  WRITE
}

/// PENDING -> ACCEPTED (normal path) or REVOKED (owner cancels it early)
/// or EXPIRED (past `expiresAt`, checked at accept time rather than by a
/// background job — see `acceptGroupInvite`'s doc comment).
enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DeadMansSwitchStatus {
  ACTIVE
  GRACE_PERIOD
  TRIGGERED
  RECOVERED
}

enum WebAuthnChallengeType {
  REGISTRATION
  AUTHENTICATION
}

enum BankConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

/// `zk*` columns back the zero-knowledge vault for `GoalContribution.note`
/// (AGENTS.md §3m) — none of them are secret. `zkSalt` and
/// `zkKdfIterations` are PBKDF2 parameters (a salt's job is to be public;
/// the iteration count is stored per-user rather than hardcoded so a
/// future stronger default doesn't invalidate already-derived keys).
/// `zkCanaryCiphertext` is a known constant encrypted under the derived
/// key — verifying a re-entered passphrase means attempting to decrypt
/// this, which reveals nothing about the passphrase itself. All three
/// null = the vault has never been set up (the universal fallback state
/// for every existing user, since this is a new, opt-in feature — see
/// §3m's migration path for what happens to notes written before it
/// existed). This app has no passphrase-rotation flow: once set up, these
/// three columns are immutable — see `setupZkVault`'s doc comment.
model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  displayName          String
  /// Argon2id hash (AGENTS.md §3ff) — null has a real, load-bearing
  /// meaning: it's what identifies the ORIGINAL seeded demo user row as
  /// still unclaimed. Every row created by registerUser() gets a real
  /// hash immediately, so null can only ever mean "this is the seed
  /// script's row, nobody has registered yet" — that's the entire
  /// mechanism behind "the first person to register inherits the demo
  /// data" rather than a separate migration flag or feature switch.
  passwordHash         String?
  /// Auth hardening pass (ad hoc, post-§3ff): null until the address has
  /// been proven reachable via `EmailVerificationToken`'s confirm flow —
  /// same "null is a real, load-bearing state" pattern `passwordHash`
  /// already establishes above, not a boolean, so the UI can show WHEN
  /// verification happened, not just whether. Never set at registration
  /// time (an email is just an identifier at that point, not yet a
  /// proven-reachable address) — only `confirmEmailVerification` sets it,
  /// mirroring `totpEnabled`'s own "only flips true once possession is
  /// actually proven" rule.
  emailVerified        DateTime?
  zkSalt               String?
  zkKdfIterations      Int?
  zkCanaryCiphertext   String?
  /// Server-side JWT revocation (Punch List Tier 2, item 2). Bumped by
  /// `bumpTokenVersion()` (src/server/auth/token-version.ts) — currently
  /// wired to the explicit "Sign out of all sessions" settings action and
  /// to disabling TOTP MFA. Auth.js's `jwt()` callback
  /// (src/server/auth/auth.ts) re-checks this against the value baked
  /// into each session token on every request that isn't a fresh sign-in;
  /// a mismatch means the token was issued before the most recent bump,
  /// and the callback returns `null` to clear that session. Starts at 1
  /// (not 0 — an explicit choice so a genuinely unset/zero-valued
  /// integer, e.g. from a raw SQL insert that forgot this column, reads
  /// as suspicious rather than as a normal starting state), never
  /// decremented — only ever compared for equality, never ordered.
  tokenVersion         Int      @default(1)
  /// AES-256-GCM ciphertext at rest (added to encrypted-fields.ts's
  /// ENCRYPTED_FIELDS, same codec as BankAccount.last4/
  /// NotableTransaction.description) — a TOTP seed is exactly as
  /// sensitive as a password and gets the same at-rest protection. Set
  /// (pending) the moment setup begins, before `totpEnabled` flips to
  /// true — see src/server/dal/mfa.ts's own doc comment for why a
  /// "pending, unconfirmed" state is real and load-bearing here, the same
  /// way `passwordHash: null` is load-bearing above.
  totpSecret           String?
  /// True only once the user has proven possession of an authenticator
  /// app by submitting one correct code against `totpSecret`
  /// (`confirmTotpSetup`) — never flipped true at the moment a secret is
  /// merely generated, which would lock a user out if they abandoned
  /// setup before finishing it.
  totpEnabled          Boolean  @default(false)
  /// RFC 6238 replay protection: the otplib time-step index of the last
  /// TOTP code this account actually accepted (login or setup
  /// confirmation) — a subsequent `verify()` call passes this back as
  /// `afterTimeStep` so the exact same 30-second code can never be
  /// accepted twice, closing an otherwise-real window for a
  /// shoulder-surfed or intercepted code. Not part of RFC 6238 itself,
  /// which doesn't mandate this — otplib's own VerifyResult exposes
  /// exactly what's needed for it "for free," so there's no reason not
  /// to.
  totpLastUsedTimeStep Int?
  /// Account lockout (Phase 3, Security & Recovery). Counts CONSECUTIVE
  /// failed authentications — a wrong password, a wrong TOTP code (after
  /// the password was already correct), or a failed passkey assertion —
  /// reset to 0 on any fully successful sign-in, OR on a successful
  /// recovery-code redemption / password reset (see `accountLockedAt`).
  /// Never decremented one at a time; only ever reset to 0 or incremented.
  failedLoginAttempts Int @default(0)
  /// Non-null once `failedLoginAttempts` reaches `LOCKOUT_THRESHOLD`
  /// (src/server/auth/account-lockout.ts) — a real, load-bearing lock,
  /// not a time-based cooldown: it persists until the account is
  /// explicitly unlocked by a successful recovery-code redemption
  /// (the "recovery-code" Credentials provider, auth.ts) or a completed
  /// password reset (`confirmPasswordReset`), never by the passage of
  /// time alone or by a subsequent correct password on its own. Checked
  /// BEFORE password verification even runs (`verifyCredentials`) — a
  /// deliberate, accepted trade-off: this necessarily reveals that a
  /// LOCKED account exists (a nonexistent email can never be locked),
  /// the same class of trade-off `checkTotpChallenge`'s required/invalid
  /// split already accepts once a password has been proven correct — but
  /// a lockout that produced no observable effect at all would defeat
  /// the feature's purpose.
  accountLockedAt      DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  settings                 UserSettings?
  bankAccounts             BankAccount[]
  categories               Category[]
  transactions             NotableTransaction[]
  transactionRules         TransactionRule[]
  envelopeAllocations      EnvelopeAllocation[]
  goals                    Goal[]
  goalContributions        GoalContribution[]
  debts                    Debt[]
  debtPayments             DebtPayment[]
  manualAssets             ManualAsset[]
  portfolioHoldings        PortfolioHolding[]
  trades                   Trade[]
  netWorthSnapshots        NetWorthSnapshot[]
  merchantEmbeddings       MerchantEmbedding[]
  dividends                Dividend[]
  subscriptionTracking     SubscriptionTracking[]
  auditLogs                AuditLog[]
  ledgerCommits            LedgerCommit[]
  authenticators           Authenticator[]
  webauthnChallenges       Challenge[]
  bankConnections          BankConnection[]
  sharedGroupsCreated      SharedGroup[]             @relation("SharedGroupsCreated")
  groupMemberships         GroupMember[]
  groupInvitesCreated      GroupInvite[]             @relation("GroupInvitesCreated")
  groupInvitesAccepted     GroupInvite[]             @relation("GroupInvitesAccepted")
  deadMansSwitch           DeadMansSwitch?
  beneficiaries            Beneficiary[]
  emergencyDocuments       EmergencyDocument[]
  recoveryShareSubmissions RecoveryShareSubmission[]
  cryptoWallets            CryptoWallet[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  notifications            Notification[]
  recoveryCodes            RecoveryCode[]
}

/// Time-limited, single-use password reset tokens (auth hardening pass,
/// ad hoc post-§3ff — ASVS-aligned: cryptographically random, not
/// predictable data like a base64-encoded email; short expiry; single
/// use). Only `tokenHash` (SHA-256 of the raw token) is ever persisted —
/// the same "hash it, never store the secret" rule already established
/// for `GroupInvite.tokenHash` (§3s) and `Beneficiary.shareHash` (§3t).
/// The raw token exists only in the outbound email and the URL the user
/// clicks; a database dump reveals no usable token.
///
/// `consumedAt` is set both on legitimate use AND when a newer token is
/// requested for the same user (`adminCreatePasswordResetToken`
/// invalidates any still-open prior token first) — a real, load-bearing
/// distinction from "doesn't exist," so a stale emailed link from an
/// earlier request reads as "used or replaced," not silently as
/// "not found," aiding support/debugging without weakening the security
/// property (either way the token no longer works).
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Time-limited, single-use email verification tokens — same shape and
/// same reasoning as `PasswordResetToken` above (deliberately not a
/// shared/generic "AuthToken" model with a purpose enum: this app's own
/// history already prefers one dedicated model per distinct flow over a
/// shared polymorphic one — `GroupInvite`, `Beneficiary`, and
/// `PasswordResetToken` each get their own table rather than a single
/// "Token" table branching on a `kind` column).
model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Cost-basis method for the tax simulator's saved default (mirrors the
/// TS union type `src/lib/tax-lots.ts` already uses at runtime — that
/// module stays a pure `src/lib/` engine with no Prisma dependency,
/// AGENTS.md §3r; this enum exists only so `UserSettings` can persist a
/// choice, never imported by tax-lots.ts itself).
enum CostBasisMethod {
  FIFO
  LIFO
}

/// Tax jurisdiction for the tax simulator's saved default — mirrors
/// `TaxJurisdiction` in src/lib/tax-rules.ts (§3r) for the same reason
/// CostBasisMethod does above.
enum TaxJurisdiction {
  US
  DE
  INTL
}

/// Mirrors `CurrencyDisplayMode` (src/lib/hooks/use-currency-display-mode.ts,
/// Punch List Phase 3) — that hook stays localStorage-backed and
/// per-browser (a deliberate choice, see its own doc comment, to avoid
/// the ThemeToggle-class hydration-mismatch bug a server-synced value
/// would reintroduce); this column is the SAVED preference a settings
/// screen can read/write, not a second live source of truth the hook
/// itself consults.
enum CurrencyDisplayMode {
  NATIVE
  ILS
}

/// Global per-user preferences and default assumptions (Punch List Tier
/// 2, item 1) — one row per user, created lazily on first read
/// (`getOrCreateUserSettings`, src/server/dal/user-settings.ts) rather
/// than at registration, so every existing user transparently gets
/// sensible defaults with no backfill migration needed.
///
/// Deliberately does NOT duplicate `ManualAsset.liquidityTier` — that
/// column remains the sole source of truth for an EXISTING asset's tier
/// (AGENTS.md §3v); mirroring its value here would violate the
/// derived-truth law (§1) the moment the two ever disagreed.
/// `defaultManualAssetLiquidityTier` below is a CREATION-TIME default
/// only, applied when a new ambiguous-type (OTHER/CRYPTO) asset is added
/// with no explicit tier chosen — a genuinely new preference, not a
/// mirror of anything that already exists.
///
/// Also deliberately excludes a "current age" field for the Monte Carlo
/// widget: this app never stores a date of birth (§1 law #6 — "Never
/// store: ... DOB"), and §3n already flagged age as necessarily a
/// per-request slider input for exactly that reason. Adding it here
/// would silently reopen a privacy decision this app already made on
/// purpose.
model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Mirrors `GET /api/tax/simulate`'s own query-param defaults (§3r) —
  /// this row is the SAVED version of those assumptions; the route still
  /// accepts an explicit per-request override, unaffected by this table.
  taxJurisdiction              TaxJurisdiction @default(US)
  taxMethod                    CostBasisMethod @default(FIFO)
  taxOtherOrdinaryIncomeAgorot BigInt          @default(0)
  taxIncludeNiit               Boolean         @default(false)
  /// A 0-1 FRACTION, not a 0-100 percentage — matches `GET
  /// /api/tax/simulate`'s existing `churchTaxRate` query param exactly
  /// (§3r: `z.coerce.number().min(0).max(1)`), which this column mirrors.
  taxChurchTaxRate             Float           @default(0)
  taxAnnualAllowanceAgorot     BigInt?
  /// Also a 0-1 fraction, despite the name — mirrors the tax-simulate
  /// route's own `flatRatePercent` param name exactly, so the two stay
  /// trivially grep-matchable as the same concept.
  taxFlatRatePercent           Float?

  /// Mirrors the Monte Carlo widget's own slider defaults (§3n) —
  /// `currentAge` deliberately excluded, see the model comment above.
  monteCarloRetirementAge           Int     @default(65)
  monteCarloTargetAnnualSpendAgorot BigInt?
  monteCarloVolatilityMultiplier    Float   @default(1)

  defaultManualAssetLiquidityTier LiquidityTier?
  preferredCurrencyDisplay        CurrencyDisplayMode @default(ILS)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Cryptographic Dead Man's Switch (AGENTS.md §3t) — one row per user,
/// protecting a dedicated "Emergency Vault" of `EmergencyDocument` rows.
///
/// This is deliberately a SEPARATE vault with its OWN master key, not an
/// extension of the zero-knowledge goal-notes vault above (`User.zk*`,
/// §3m): that vault's derived key is created with `extractable: false`
/// specifically so it can never be exported from the browser, by design.
/// Splitting a key via Shamir's Secret Sharing fundamentally requires
/// exporting its raw bytes at setup time — doing that to the zk-vault key
/// would silently undermine the one property it exists for. This vault's
/// key (`vaultSalt`/`vaultKdfIterations`, derived in
/// src/lib/dead-mans-switch-crypto.ts) is deliberately extractable for
/// exactly as long as setup takes, then immediately split into
/// `totalShares` Shamir shares and discarded — the server never stores
/// the raw key or any share (see Beneficiary's `shareHash`).
/// `vaultCanaryCiphertext` is the same "encrypt a known constant, verify
/// by attempting to decrypt it" pattern as `User.zkCanaryCiphertext` —
/// used both by the owner (confirming their recovery passphrase still
/// works) and, critically, by the server during recovery to confirm a
/// set of combined shares reconstructed the CORRECT key before it ever
/// attempts to decrypt a real document.
///
/// `status` lifecycle: ACTIVE -> GRACE_PERIOD (inactivity threshold
/// crossed) -> TRIGGERED (grace period also elapsed — the recovery portal
/// opens for beneficiaries) -> RECOVERED (threshold shares combined
/// successfully). GRACE_PERIOD reverts to ACTIVE automatically on any
/// activity (src/server/auth/current-user.ts's activity touch); TRIGGERED
/// does NOT auto-revert on activity — a switch already open for recovery
/// requires an explicit owner action (`cancelRecovery`) rather than a
/// passive page load, so an incidental API call mid-recovery can't
/// silently undo beneficiaries' already-submitted shares. See
/// AGENTS.md §3t for the full design rationale.
model DeadMansSwitch {
  id                      String               @id @default(cuid())
  userId                  String               @unique
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                  DeadMansSwitchStatus @default(ACTIVE)
  inactivityThresholdDays Int                  @default(90)
  gracePeriodDays         Int                  @default(14)
  lastActivityAt          DateTime             @default(now())
  graceStartedAt          DateTime?
  triggeredAt             DateTime?
  recoveredAt             DateTime?
  /// N — total number of Shamir shares generated at setup.
  totalShares             Int
  /// M — shares required to reconstruct the master key (M <= N).
  thresholdShares         Int
  /// PBKDF2 salt — public by design, see zkSalt's comment above for why.
  vaultSalt               String
  vaultKdfIterations      Int
  vaultCanaryCiphertext   String
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  beneficiaries    Beneficiary[]
  documents        EmergencyDocument[]
  shareSubmissions RecoveryShareSubmission[]

  @@index([status])
}

/// One row per Shamir share slot (`shareIndex` 1..totalShares). The raw
/// share VALUE is never persisted anywhere in this app — only
/// `shareHash` (SHA-256 hex of the raw share bytes, computed client-side
/// at setup), which lets the recovery portal verify a beneficiary's
/// submitted share belongs to this slot without the server ever needing
/// to already hold it. `inviteTokenHash` is the standard "hash it, never
/// store the secret" treatment `GroupInvite.tokenHash` already uses
/// (§3s) — the raw token (which page to visit) and the raw share value
/// (the actual secret) are shown to the owner together exactly once at
/// setup, then distributed out-of-band to two different real-world
/// channels by convention (e.g. the token by email, the share on paper) —
/// the app is never in a position to leak both at once after that
/// moment, because it never stores either of them again.
model Beneficiary {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadMansSwitchId String
  deadMansSwitch   DeadMansSwitch @relation(fields: [deadMansSwitchId], references: [id], onDelete: Cascade)
  label            String
  shareIndex       Int
  shareHash        String
  inviteTokenHash  String         @unique
  createdAt        DateTime       @default(now())

  submissions RecoveryShareSubmission[]

  @@unique([deadMansSwitchId, shareIndex])
  @@index([userId])
  @@index([deadMansSwitchId])
}

/// An emergency document — arbitrary free text (account instructions,
/// asset locations, final wishes, etc.) AES-256-GCM encrypted entirely
/// client-side (src/lib/dead-mans-switch-crypto.ts, "dms1:" format)
/// under the vault's master key before ever reaching the server. Same
/// zero-knowledge-at-rest property `GoalContribution.note` has (§3m) —
/// the crucial difference (see DeadMansSwitch's model comment) is that
/// THIS key is designed to eventually be reconstructed and used
/// server-side exactly once, during a successful recovery.
model EmergencyDocument {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadMansSwitchId String
  deadMansSwitch   DeadMansSwitch @relation(fields: [deadMansSwitchId], references: [id], onDelete: Cascade)
  title            String
  ciphertext       String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([deadMansSwitchId])
}

/// A beneficiary's submitted share during an active recovery (only
/// accepted while `DeadMansSwitch.status = TRIGGERED`).
/// `shareValueCiphertext` is the raw share value, encrypted at rest under
/// the app-wide field-encryption codec (src/server/crypto/field-encryption.ts
/// — the same codec `NotableTransaction.description` uses), deliberately
/// NOT a zero-knowledge value: reconstructing the master key fundamentally
/// requires the server to combine >= threshold shares together in one
/// place at some point, which is a one-time, narrowly-scoped, DOCUMENTED
/// server-side exposure — the same honest treatment
/// `findLegacyNoteContributions` gives its own unavoidable exposure
/// (§3m), never pretended to be zero-knowledge. Field-level encryption
/// here is defense-in-depth against a raw database dump between
/// submissions, not a claim that the server can never combine them.
model RecoveryShareSubmission {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadMansSwitchId     String
  deadMansSwitch       DeadMansSwitch @relation(fields: [deadMansSwitchId], references: [id], onDelete: Cascade)
  beneficiaryId        String
  beneficiary          Beneficiary    @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  shareValueCiphertext String
  submittedAt          DateTime       @default(now())

  @@unique([deadMansSwitchId, beneficiaryId])
  @@index([userId])
  @@index([deadMansSwitchId])
}

/// User-defined categories with permanent slugs: renaming changes `name`
/// only, `slug` never changes once created, so rules/links keyed on it
/// survive a rename. Every user gets exactly one `isUncategorized` row at
/// seed/user-creation time — deleting a category reassigns its
/// transactions to that row before the delete (enforced at the DAL layer;
/// the DB does not cascade-delete transactions when a category is
/// removed, precisely so a skipped reassignment step fails loudly instead
/// of silently orphaning transactions).
///
/// `sharedGroupId` (AGENTS.md §3s) is nullable and additive: `userId`
/// always stays the true owner (a category is never transferred), and
/// setting `sharedGroupId` only extends *visibility* (and, for a WRITE
/// member, editability of `name`) to the rest of that SharedGroup — never
/// its `transactions`, which stay strictly personal regardless of
/// sharing (see SharedGroup's own model comment).
model Category {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  isUncategorized Boolean      @default(false)
  archivedAt      DateTime?
  sharedGroupId   String?
  sharedGroup     SharedGroup? @relation(fields: [sharedGroupId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  transactions        NotableTransaction[]
  envelopeAllocations EnvelopeAllocation[]
  merchantEmbeddings  MerchantEmbedding[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([sharedGroupId])
}

/// Credit balances are stored positive = money owed (a $500 credit card
/// balance is `nativeBalance = 50000`, not `-50000`).
///
/// `nativeBalance` is the account's own currency's minor units — the only
/// balance actually stored. There is deliberately no stored ILS-agorot
/// mirror: a live balance's base-currency value moves every time the FX
/// rate does, so storing one would immediately go stale (a "derived
/// truth" violation, AGENTS.md law #5). The DAL computes the ILS
/// equivalent at read time from the latest `ExchangeRate` row, the same
/// "today is live, never stored" treatment NetWorthSnapshot already gets.
/// `sharedGroupId` (AGENTS.md §3s) extends visibility of this row itself
/// (balance, institution, nickname) to the SharedGroup's members — a
/// household's joint checking account can show its shared balance for a
/// household net-worth view. `transactions` are deliberately NOT included
/// in that grant: NotableTransaction keeps its own strictly-personal RLS
/// policy untouched regardless of whether the account it posted to is
/// shared, so a shared account's balance is visible without exposing the
/// owner's individual line-item spending — the "personal asset vaults
/// stay strictly isolated" half of the feature.
model BankAccount {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionName String
  /// Encrypted at rest — see file header.
  last4           String
  accountType     BankAccountType
  nickname        String?
  currency        Currency        @default(ILS)
  /// Minor units of `currency` (agorot if ILS, cents otherwise).
  nativeBalance   BigInt
  sharedGroupId   String?
  sharedGroup     SharedGroup?    @relation(fields: [sharedGroupId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  transactions NotableTransaction[]
  bankConnection BankConnection?

  @@index([userId])
  @@index([sharedGroupId])
}

/// The ledger. `providerTransactionId` is the CSV/bank-provided reference
/// used for idempotent upserts on re-import; it's null for manually
/// entered transactions, and Postgres treats multiple NULLs in a unique
/// constraint as non-colliding, so manual entries never fight each other
/// over uniqueness. `amount`/`nativeAmount` are signed: negative =
/// expense, positive = income/credit.
///
/// `amount` (ILS agorot) and `exchangeRateAtEntry` are historical facts
/// captured ONCE, at entry/import time — like Trade.totalAgorot, a past
/// transaction's ILS equivalent isn't a "derived truth" violation to
/// store, because re-deriving it later with today's rate would silently
/// rewrite history every time FX rates move. `nativeAmount` is the
/// original ledger fact exactly as it appeared on the native
/// statement/CSV/form. For an ILS-native transaction, `amount ===
/// nativeAmount` and `exchangeRateAtEntry` is null (rate is trivially 1,
/// no real conversion happened).
model NotableTransaction {
  id                    String                      @id @default(cuid())
  userId                String
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccountId         String
  bankAccount           BankAccount                 @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  categoryId            String
  category              Category                    @relation(fields: [categoryId], references: [id])
  providerTransactionId String?
  occurredAt            DateTime
  postedAt              DateTime?
  currency              Currency                    @default(ILS)
  /// Minor units of `currency`, signed.
  nativeAmount          BigInt
  /// ILS agorot equivalent, signed — see model comment.
  amount                BigInt
  /// ILS per 1 unit of `currency` at entry time. Null when currency = ILS.
  exchangeRateAtEntry   Decimal?                    @db.Decimal(12, 6)
  /// Encrypted at rest — untrusted free text, see file header and
  /// docs/SECURITY.md §3.4 (indirect prompt injection surface).
  description           String
  merchantName          String?
  isManual              Boolean                     @default(false)
  needsReview           Boolean                     @default(false)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  /// Semantic search index (AGENTS.md §3cc) — a 384-dim pgvector
  /// embedding of this row's merchant/description text, computed
  /// CLIENT-SIDE only (same "no financial text leaves the device"
  /// property §3u/§3aa already hold for MerchantEmbedding) and populated
  /// via raw SQL (Prisma's `Unsupported` type has no typed read/write
  /// path — see src/server/dal/transactions.ts). Null for any
  /// transaction that never had a client-computed embedding available
  /// at create/recategorize time (every pre-existing row, CSV-imported
  /// rows, and any manual entry from a browser where the embedding
  /// model failed to load) — forward-only coverage, same accepted
  /// limitation §3u's own MerchantEmbedding backfill gap already
  /// documents, not retroactively computed.
  ///
  /// KNOWN, DELIBERATE trade-off, stated plainly rather than glossed
  /// over: `description` is encrypted at rest specifically because it's
  /// treated as sensitive free text (this model's own comment above,
  /// docs/SECURITY.md §3.4). This column stores an UNENCRYPTED vector
  /// derived from that same text — not the plaintext itself, but a
  /// lossy representation an adversary with both database access and
  /// the same public embedding model could, in principle, narrow down
  /// via a dictionary/near-match attack for short, guessable strings
  /// (this is a real, inherent limitation of ANY server-side vector
  /// similarity search over data whose plaintext must otherwise stay
  /// hidden — there's no way around it without exotic techniques like
  /// homomorphic encryption, well outside this app's scope). This is
  /// the same accepted trade-off `MerchantEmbedding.sampleMerchantName`
  /// already makes for merchant names (stored in plaintext by design),
  /// extended here to description text for the first time — flagged
  /// explicitly rather than silently introduced.
  searchEmbedding       Unsupported("vector(384)")?
  ledgerCommits         LedgerCommit[]

  @@unique([userId, providerTransactionId])
  @@index([userId, occurredAt])
  @@index([userId, categoryId])
  @@index([userId, bankAccountId])
}

/// Tier 0 of the categorization pipeline (src/lib/categorization/
/// rule-engine.ts) — user-defined deterministic rules evaluated BEFORE
/// the existing 4-tier cascade, on both CSV import and manual entry.
/// `conditions`/`actions` are `Json`, not a normalized table: validated
/// by Zod at the API boundary (RuleCondition[]/RuleAction[] in
/// rule-engine.ts), not by the DB — same "keep the schema stable while
/// the rule vocabulary grows" call TransactionRule's own design doc
/// makes, matching how MonteCarlo/tax UserSettings already store
/// structured preferences as Json rather than one column per field.
/// `priority`: lower runs first (ties broken by `createdAt`, oldest
/// first) — `applyRules` in rule-engine.ts is what actually enforces
/// this order, not a DB `ORDER BY` the DAL happens to use.
model TransactionRule {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  conditions Json
  actions    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, priority])
}

/// Zero-sum envelope budgeting (replaces the old stateless `Budget`
/// monthly-limit model). One row per (user, category, month) — an
/// AMOUNT ALLOCATED to that category for that specific month, not a
/// running balance: `src/server/dal/envelopes.ts` computes each
/// envelope's rolling balance by summing every allocation up to and
/// including a target month and subtracting that same window's actual
/// spend, live, never stored — same "derived truth" law `Budget`'s own
/// utilization already followed, just applied to a genuinely
/// carry-forward figure instead of a calendar-reset one.
///
/// `month` is a plain `YYYY-MM` string, not a `DateTime` — deliberately,
/// to avoid ANY timezone-boundary ambiguity about which month an
/// allocation belongs to (a `DateTime` at a month boundary is exactly
/// the kind of value that reads as a different calendar month depending
/// on which timezone asks). Comparing/summing "up to month X" is a
/// plain string comparison, safe because `YYYY-MM` sorts identically to
/// its own chronological order.
///
/// `sharedGroupId` (AGENTS.md §3s), preserved from `Budget`: nullable,
/// additive — `userId` always stays the true owner/creator, sharing
/// only extends visibility (and, for a WRITE-permission member,
/// editability) to the rest of the group. Granularity note: sharing is
/// keyed by CATEGORY, not by one allocation row — `setResourceSharing`'s
/// "budget" case (`shared-groups.ts`) sets `sharedGroupId` on every
/// existing allocation row for a (user, category), and a new month's
/// allocation for an already-shared category inherits that same
/// `sharedGroupId` automatically (`envelopes.ts`'s `allocateToEnvelope`)
/// — the practical equivalent of "sharing was a per-category decision"
/// that `Budget`'s own one-row-per-category shape made trivial, adapted
/// to a model with many rows per category over time.
model EnvelopeAllocation {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Agorot — the amount allocated to this category for this month.
  amountAgorot  BigInt
  /// `YYYY-MM`, always UTC-anchored at the call site (src/lib/money.ts's
  /// sibling `src/lib/date-month.ts`) — see the model comment above.
  month         String
  sharedGroupId String?
  sharedGroup   SharedGroup? @relation(fields: [sharedGroupId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, categoryId, month])
  @@index([userId, categoryId])
  @@index([userId, month])
  @@index([sharedGroupId])
}

/// Progress is derived from `contributions`, never stored on this model —
/// the "derived truth" law.
model Goal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /// Agorot.
  targetAmount BigInt
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contributions GoalContribution[]

  @@index([userId])
}

/// Signed: positive = contribution, negative = withdrawal.
model GoalContribution {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId        String
  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// Agorot, signed.
  amount        BigInt
  contributedAt DateTime
  /// Zero-knowledge ciphertext (AGENTS.md §3m) — a "zk1:iv:ciphertext"
  /// blob produced entirely client-side by src/lib/zk-crypto.ts under a
  /// key derived from the user's master passphrase. NOT covered by the
  /// server-side field-encryption extension (src/server/db/encrypted-fields.ts)
  /// — the server stores and returns this opaque string as-is and can
  /// never decrypt it, which is the entire point. A value still in the
  /// OLD "v1:iv:tag:ciphertext" format (field-encryption.ts) is a
  /// pre-migration legacy row — see zk-vault.ts's migration path.
  note          String?
  createdAt     DateTime @default(now())

  @@index([userId, goalId])
}

model Debt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  debtType       DebtType
  /// Agorot, positive = amount owed.
  currentBalance BigInt
  /// Basis points.
  aprBps         Int
  /// Agorot.
  minimumPayment BigInt
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments DebtPayment[]

  @@index([userId])
}

/// `principalPortion`/`interestPortion` are nullable because the Phase 3
/// debt-math engine computes the split; a payment can be recorded before
/// that breakdown is known.
model DebtPayment {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  debtId           String
  debt             Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  /// Agorot.
  amount           BigInt
  /// Agorot.
  principalPortion BigInt?
  /// Agorot.
  interestPortion  BigInt?
  paidAt           DateTime
  createdAt        DateTime @default(now())

  @@index([userId, debtId])
}

/// Off-feed assets (property, vehicles, crypto, pension/Keren Hishtalmut).
/// Valuation freshness (Fresh/Aging/Stale) is derived from `valuedAt` at
/// read time, never stored. `taxAdvantaged`/`liquidityDate` exist mainly
/// for KEREN_HISHTALMUT, which has a real 6-year liquidity lock-in under
/// Israeli law.
///
/// `liquidityTier` (AGENTS.md §3v) is nullable BY DESIGN, not merely
/// "not migrated yet": null means "derive the tier from `assetType`" (the
/// sensible default for every existing row, since this app had no notion
/// of liquidity tiers before this column existed) via
/// `classifyManualAssetLiquidity` — a non-null value is an explicit user
/// override for the genuinely ambiguous cases the default can't get right
/// on its own (e.g. a self-custodied CRYPTO holding the user considers
/// effectively illiquid, or an OTHER asset — a gold bar, a collectible —
/// they consider more liquid than the conservative ILLIQUID default).
/// This is the "derived truth, overridable" shape law #5 already
/// establishes elsewhere in this schema (valuation freshness above is
/// the pure-derived case with no override at all; this is the same idea
/// with one).
model ManualAsset {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  assetType     AssetType
  /// Agorot.
  currentValue  BigInt
  valuedAt      DateTime
  taxAdvantaged Boolean        @default(false)
  liquidityDate DateTime?
  liquidityTier LiquidityTier?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
}

/// `quantity` uses Decimal (not the Agorot integer primitive) because
/// share counts, not money, are the quantity here — fractional shares are
/// legitimate and Decimal/numeric is the correct fixed-precision type for
/// them. `totalCostBasis` is the total agorot invested in the current
/// position; weighted-average cost per share is derived at read time
/// (`totalCostBasis / quantity`), never stored, again per "derived truth".
///
/// `nativeCostBasis` is the same total, in the instrument's native
/// currency (`currency`, USD for every mock symbol today) — both are
/// historical accumulations of Trade.totalAgorot/nativeTotalAgorot, so
/// keeping both is consistent with those being stored historical facts,
/// not a re-derivable aggregate stored twice.
///
/// `Decimal(30, 18)` (widened from `Decimal(20, 8)` in the Advanced
/// Crypto & On-Chain Asset Tracking pass, AGENTS.md §3w) — 18 fractional
/// digits is the real precision on-chain ERC-20/native-token quantities
/// need (1 wei = 1e-18 ETH); 8 was already generous for a fractional
/// stock/ETF share but would silently truncate a genuine on-chain
/// quantity. Safe, lossless widening for every existing row: Postgres
/// preserves an existing `numeric` value exactly when both precision and
/// scale increase, confirmed against the actual migrated rows, not
/// assumed — see that migration's own note. `src/lib/crypto/token-units.ts`
/// is the actual 18-decimal-safe arithmetic this column's values should
/// be run through (BigInt wei, never a float) — this column just needed
/// to stop being the precision ceiling before that math could matter.
model PortfolioHolding {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol          String
  assetClass      AssetClass @default(STOCK)
  quantity        Decimal    @db.Decimal(30, 18)
  currency        Currency   @default(USD)
  /// Agorot.
  totalCostBasis  BigInt
  /// Minor units of `currency`.
  nativeCostBasis BigInt
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  trades    Trade[]
  dividends Dividend[]

  @@unique([userId, symbol])
}

/// The order blotter. `symbol` is denormalized from the holding for
/// blotter display without a join. `totalAgorot` is the historical
/// execution record (quantity × price, rounded once at execution time) —
/// storing it is not a "derived truth" violation, since a completed
/// trade's own total is a historical fact like a ledger entry, not a
/// rederivable aggregate. `idempotencyKey` backs the Idempotency-Key
/// header requirement on trade submission (Section 2.4).
///
/// Every ILS (`*Agorot`) figure here has a native-currency counterpart
/// (`native*`, USD minor units for every mock symbol today) plus
/// `exchangeRateAtEntry` — the rate actually used for this execution's
/// conversion, captured once and never recomputed, making explicit and
/// auditable what was previously only an implicit constant in
/// mock-market-data.ts (AGENTS.md §3k).
model Trade {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioHoldingId  String
  portfolioHolding    PortfolioHolding @relation(fields: [portfolioHoldingId], references: [id], onDelete: Cascade)
  symbol              String
  side                TradeSide
  /// `Decimal(30, 18)` — see PortfolioHolding.quantity's doc comment for why.
  quantity            Decimal          @db.Decimal(30, 18)
  currency            Currency         @default(USD)
  /// Agorot, price per share at execution.
  priceAgorot         BigInt
  /// Agorot.
  totalAgorot         BigInt
  /// Agorot, SELL only. The weighted-average cost basis at the moment of
  /// sale isn't reconstructable later without replaying the full trade
  /// history, so this is captured once, at execution time, like
  /// `totalAgorot` — a historical fact, not a "derived truth" violation.
  realizedPnlAgorot   BigInt?
  /// Minor units of `currency`, price per share at execution.
  nativePriceAmount   BigInt
  /// Minor units of `currency`.
  nativeTotalAmount   BigInt
  /// Minor units of `currency`, SELL only — see `realizedPnlAgorot`.
  nativeRealizedPnl   BigInt?
  /// ILS per 1 unit of `currency`, used for this execution's conversion.
  exchangeRateAtEntry Decimal          @db.Decimal(12, 6)
  executedAt          DateTime
  idempotencyKey      String?
  createdAt           DateTime         @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, executedAt])
}

/// Historical only — "today" is always computed live by the DAL, never
/// read from this table.
model NetWorthSnapshot {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotDate           DateTime @db.Date
  /// Agorot.
  totalAssetsAgorot      BigInt
  /// Agorot.
  totalLiabilitiesAgorot BigInt
  /// Agorot.
  netWorthAgorot         BigInt
  createdAt              DateTime @default(now())

  @@unique([userId, snapshotDate])
}

/// 384-dimension embedding cache for merchant-name categorization (Tier 3
/// KNN, Phase 3). Stored as a native float array rather than a pgvector
/// column for now — Phase 3's KNN engine can do cosine similarity in
/// application code at this data scale; revisit if that becomes a
/// bottleneck.
///
/// `categoryId` was added in the Self-Learning Vector Categorization
/// Engine pass (AGENTS.md §3u) — this table had NEVER been read or
/// written anywhere in the app before that pass (confirmed by grep, not
/// assumed), so adding a required column here is not a backward-
/// compatibility concern; there was no existing data to migrate. Every
/// row is a "correction": one (user, merchant) pair's confirmed
/// category, refreshed via upsert every time the user recategorizes a
/// transaction for that merchant — see `upsertMerchantEmbedding`'s doc
/// comment for why this is an upsert, not an append-only log.
/// `onDelete: Cascade` on `category` matches `Budget.categoryId`'s
/// existing precedent: a hard-deleted category (not merely archived —
/// see `deleteCategoryWithReassignment`) makes any embedding correction
/// pointing at it meaningless.
model MerchantEmbedding {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantKey        String
  sampleMerchantName String
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  embedding          Float[]
  /// Which embedding model produced `embedding` — vectors from different
  /// models are NOT comparable via cosine similarity even at the same
  /// dimensionality, so this is what lets listEmbeddingCorrections()
  /// exclude a row from KNN voting the instant the client-side model
  /// changes, instead of silently comparing apples to oranges. Existing
  /// rows predating this column back-fill to "legacy-unversioned", a
  /// value that deliberately matches no real model id — see the
  /// migration and src/lib/embeddings/embedding-model.ts.
  embeddingModel     String   @default("legacy-unversioned")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, merchantKey])
  @@index([categoryId])
}

/// A dividend declared on a holding the user owns.
///
/// The stored-vs-derived split here is deliberate and follows the same
/// rule as Trade vs. BankAccount (AGENTS.md law #5):
///  - `status = PAID` — the payout already happened, so the amount
///    actually received (`totalNativeAmount`/`totalAgorot`), the share
///    count it was paid on (`quantityAtPayment`), and the FX rate used
///    (`exchangeRateAtEntry`) are historical facts, captured once. They
///    are NOT recomputed later: the position and the rate both move, and
///    re-deriving would silently rewrite history.
///  - `status = ANNOUNCED` — the payout hasn't happened yet, so those
///    four columns are null and the projected amount is computed live
///    from today's quantity and today's rate. Storing a projection would
///    go stale the moment either changed.
///
/// `amountPerShareNative` is the declared per-share rate, which is a fact
/// about the *instrument* rather than the position, so it is stored for
/// both statuses.
model Dividend {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioHoldingId   String
  portfolioHolding     PortfolioHolding @relation(fields: [portfolioHoldingId], references: [id], onDelete: Cascade)
  /// Denormalized from the holding, same reason as Trade.symbol — blotter/
  /// schedule display without a join.
  symbol               String
  currency             Currency         @default(USD)
  /// Minor units of `currency`, per single share. Declared rate.
  amountPerShareNative BigInt
  /// The date the holding must be owned by to qualify.
  exDate               DateTime
  /// The date the cash actually lands.
  payDate              DateTime
  status               DividendStatus   @default(ANNOUNCED)
  /// PAID only — shares held when the dividend was paid.
  quantityAtPayment    Decimal?         @db.Decimal(20, 8)
  /// PAID only — minor units of `currency` actually received.
  totalNativeAmount    BigInt?
  /// PAID only — ILS agorot actually received.
  totalAgorot          BigInt?
  /// PAID only — ILS per 1 unit of `currency` at payment.
  exchangeRateAtEntry  Decimal?         @db.Decimal(12, 6)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([userId, symbol, exDate])
  @@index([userId, payDate])
  @@index([userId, portfolioHoldingId])
}

/// Daily ILS exchange rates, fetched by the background sync service
/// (src/server/currency/, AGENTS.md §3k). Deliberately NOT user-scoped or
/// RLS-protected — exchange rates are public market data belonging to no
/// user, so the blanket per-user scoping convention (see this file's
/// header) doesn't apply, the same way MerchantEmbedding's per-user
/// scoping was a deliberate deviation in the opposite direction. ILS
/// itself never gets a row here — its rate against itself is always
/// exactly 1 and never looked up (see exchange-rate.ts's IDENTITY_RATE).
///
/// `rate` is ILS per 1 unit of `currency`. Stored as Decimal rather than
/// an integer "micros" column: Prisma/Postgres's Decimal is already exact
/// base-10 arithmetic (backed by decimal.js, not IEEE754 float), so there
/// is no float-drift risk here to guard against with a bespoke integer
/// scaling trick the way agorot/basis-points do for actual money — see
/// src/lib/exchange-rate.ts, which treats a rate as a plain finite
/// `number` ratio at the application layer (same reasoning as
/// money.ts's `multiplyAgorot`'s `factor` parameter).
model ExchangeRate {
  id        String   @id @default(cuid())
  currency  Currency
  /// ILS per 1 unit of `currency`.
  rate      Decimal  @db.Decimal(12, 6)
  asOfDate  DateTime @db.Date
  source    String
  fetchedAt DateTime @default(now())

  @@unique([currency, asOfDate])
  @@index([currency, asOfDate])
}

/// Daily crypto-asset prices against ILS, fetched by the background sync
/// service (`src/server/crypto/price-sync.ts`, AGENTS.md §3w) — the
/// Advanced Crypto & On-Chain Asset Tracking module's real (non-mock)
/// price feed, deliberately mirroring `ExchangeRate` in every structural
/// respect: same "public market data, not user-scoped or RLS-protected"
/// reasoning (a symbol's price belongs to no user), same Decimal-ratio
/// storage (`rate` is ILS per 1 WHOLE unit of `symbol` — e.g. per 1 ETH,
/// never per wei — a genuinely different number from the 18-decimal
/// on-chain balance math this feed's consumer,
/// `src/server/crypto/build-wallet-balances.ts`, does separately), same
/// `@@unique([symbol, asOfDate])` upsert-idempotency shape. Kept as its
/// own model rather than folded into `ExchangeRate` because `Currency` is
/// a closed fiat enum (ILS/USD/EUR/GBP) — reusing it for "ETH" would mean
/// either widening a fiat-currency enum to include crypto symbols (wrong
/// on its face) or storing crypto prices as a string abuse of an enum
/// column; a separate free-text `symbol` column is the honest fit.
model CryptoAssetPrice {
  id        String   @id @default(cuid())
  /// e.g. "ETH" — free text, not a closed enum (see model comment for why), but always uppercase (enforced at the DAL write path).
  symbol    String
  /// ILS per 1 whole unit of `symbol`.
  rate      Decimal  @db.Decimal(20, 6)
  asOfDate  DateTime @db.Date
  source    String
  fetchedAt DateTime @default(now())

  @@unique([symbol, asOfDate])
  @@index([symbol, asOfDate])
}

/// A tracked public EVM (Ethereum-compatible) wallet address (AGENTS.md
/// §3w) — read-only observation, never custody: this app never asks for,
/// stores, or could even represent a private key or seed phrase (Tier 0
/// defense, AGENTS.md §2.1's "never store bank login credentials" law
/// applied to the on-chain equivalent). Only the public `address` — which
/// anyone can already see on a public block explorer — is stored.
///
/// The wallet's balance is NEVER stored here — it's fetched live from a
/// public RPC endpoint (`eth_getBalance`,
/// `src/server/crypto/evm-rpc-client.ts`) every time it's needed, the
/// same "derived truth" law (#5) `computeLiveNetWorth` already applies to
/// a live bank-account balance or a live mock stock price: a wallet's
/// real balance changes outside this app entirely (the user's own
/// on-chain transactions), so a stored mirror would go stale the moment
/// it did.
///
/// `stakingYieldBps`/`cumulativeGasFeesWei` are deliberately USER-SUPPLIED
/// informational fields, not auto-discovered — `eth_getBalance` alone
/// (this module's one integration point, per the task's own framing)
/// cannot discover historical gas spend or a staking position's actual
/// yield; that needs a full transaction-history indexer (an Etherscan-
/// style API), which is out of this pass's scope — see AGENTS.md §3w's
/// known-limitations note. `stakingYieldBps` follows this app's existing
/// basis-points-for-rates law (#2); `cumulativeGasFeesWei` follows the
/// same "the smallest on-chain unit is already an integer, so BigInt is
/// the correct type, no Decimal needed" reasoning `src/lib/crypto/token-units.ts`
/// uses throughout — 1 wei is indivisible, exactly like 1 agorot.
model CryptoWallet {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lowercase-normalized at the DAL write path (EVM addresses are case-insensitive at the protocol level; EIP-55 mixed-case checksum validation is explicitly NOT implemented — see AGENTS.md §3w).
  address              String
  /// EVM chain id — 1 = Ethereum mainnet, the only chain this pass's RPC client targets.
  chainId              Int      @default(1)
  label                String
  stakingYieldBps      Int?
  cumulativeGasFeesWei BigInt?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, address, chainId])
  @@index([userId])
}

enum SubscriptionReviewStatus {
  ACTIVE
  REVIEWED
  CANCELLED
}

/// Per-user, per-merchant subscription review state (AGENTS.md §3p) — the
/// stateful half of the subscription radar. `merchantKey` is the radar's
/// *canonical* fuzzy-cluster key (src/lib/subscription-radar.ts), not a
/// raw per-transaction merchantKey — a subscription billed under several
/// slightly different descriptor strings still has exactly one review
/// status, keyed on whichever raw string the radar picked as canonical
/// for that cluster. A row only exists once a user has explicitly
/// reviewed or cancelled something; a merchant with no row here is
/// implicitly ACTIVE — see `getSubscriptionStatuses`'s doc comment for
/// why that default lives in the DAL, not as a `@default` here.
model SubscriptionTracking {
  id          String                   @id @default(cuid())
  userId      String
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantKey String
  status      SubscriptionReviewStatus
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([userId, merchantKey])
  @@index([userId])
}

/// A household/shared space (AGENTS.md §3s). Owns nothing itself — it's a
/// scoping boundary that specific Budget/BankAccount/Category rows opt
/// into via their own nullable `sharedGroupId`, never a container that
/// copies or duplicates data. `NotableTransaction` and every other
/// personal model (Goal, Debt, ManualAsset, PortfolioHolding, ...) have
/// no `sharedGroupId` at all and stay strictly single-user, by omission
/// — "personal asset vaults stay strictly isolated" is enforced by which
/// models this feature touches, not by a runtime check.
///
/// `createdById` is the group's one OWNER — ownership never transfers in
/// this pass (no "make someone else the owner" flow); deleting the owner
/// cascades away the whole group and every share grant on it (a shared
/// Budget/BankAccount/Category row itself survives via `onDelete:
/// SetNull` on `sharedGroupId` — only the *sharing* is undone, not the
/// underlying resource, which still belongs to whichever member actually
/// owns it).
model SharedGroup {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdBy   User     @relation("SharedGroupsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members             GroupMember[]
  invites             GroupInvite[]
  envelopeAllocations EnvelopeAllocation[]
  bankAccounts        BankAccount[]
  categories          Category[]

  @@index([createdById])
}

/// One row per (user, group) — the only way a GroupMember row is ever
/// created is a user accepting their own invite (or the owner creating
/// their own OWNER row at group-creation time), both of which are a
/// self-insert of `userId = <the acting user>`. There is deliberately no
/// "owner directly adds someone" path — see `createGroupInvite`'s doc
/// comment. `permission` is read by MEMBER rows only; an OWNER row's
/// permission is always implicitly WRITE regardless of this column's
/// value (see the RLS helper functions in the migration this model
/// shipped with).
model GroupMember {
  id            String          @id @default(cuid())
  sharedGroupId String
  sharedGroup   SharedGroup     @relation(fields: [sharedGroupId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          GroupRole       @default(MEMBER)
  permission    SharePermission @default(READ)
  joinedAt      DateTime        @default(now())

  @@unique([sharedGroupId, userId])
  @@index([userId])
}

/// A pending invitation to join a SharedGroup. `tokenHash` is a SHA-256
/// hash of a single-use random token generated in
/// `src/server/dal/shared-groups.ts` — the raw token is returned to the
/// inviter exactly once (to send out-of-band: email, a shared link) and
/// is never itself persisted, the same "hash it, never store the secret"
/// treatment a real password would get if this app had one yet (and
/// exactly the treatment `zk-crypto.ts`'s canary already gives a
/// passphrase, §3m). A row's `status` moves PENDING -> ACCEPTED/REVOKED
/// once; EXPIRED is assigned lazily at accept-time when `expiresAt` has
/// passed rather than by a background sweep (see `acceptGroupInvite`).
model GroupInvite {
  id            String          @id @default(cuid())
  sharedGroupId String
  sharedGroup   SharedGroup     @relation(fields: [sharedGroupId], references: [id], onDelete: Cascade)
  invitedEmail  String
  tokenHash     String          @unique
  permission    SharePermission @default(READ)
  status        InviteStatus    @default(PENDING)
  expiresAt     DateTime
  createdById   String
  createdBy     User            @relation("GroupInvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedById  String?
  acceptedBy    User?           @relation("GroupInvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([sharedGroupId])
  @@index([invitedEmail])
}

/// Append-only. Nothing in the application ever calls `.update()` or
/// `.delete()` on this model — enforced additionally at the DB level by a
/// trigger (prisma/migrations/*_rls_and_runtime_role) that rejects UPDATE
/// and DELETE on this table outright.
model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  action     AuditAction
  beforeData Json?
  afterData  Json?
  occurredAt DateTime    @default(now())

  @@index([userId, entityType, entityId])
  @@index([userId, occurredAt])
}

/// Cryptographic Ledger Versioning (ad hoc) — a per-transaction,
/// hash-chained, append-only history for tamper-EVIDENCE only, not a
/// mutation/rollback mechanism. Scoped down from an originally-requested
/// rollback engine after a real architecture conflict was raised and
/// confirmed with the user: this app's own established law (§1 "derived
/// truth" + the consistent "historical facts are frozen once recorded"
/// pattern every other feature follows — Trade amounts, Dividend payout
/// fields, exchangeRateAtEntry) means a transaction, once committed, is
/// never retroactively rewritten; every other feature (budgets, net
/// worth snapshots, insights, the tax simulator, the subscription radar)
/// reads NotableTransaction as ground truth with no awareness of a
/// patch-history layer, so a rollback would silently desync all of them.
///
/// Genuinely append-only, not just append-only "by convention" the way a
/// rollback-oriented design would need to be reversible — enforced
/// identically to AuditLog (same REVOKE UPDATE, DELETE + rejection
/// trigger, prisma/migrations/*_ledger_commit_append_only): nothing in
/// this table can be silently rewritten to match a since-altered
/// transaction, which is the entire point of a tamper-evidence chain.
///
/// The chain is scoped PER TRANSACTION (previousHash links to that same
/// transactionId's prior commit), not one global ledger-wide chain
/// across every transaction — a global chain would need a single
/// serialized "head" pointer per user that every concurrent
/// create/update would race to extend, real write contention for no
/// benefit here: verifying one transaction's own history is exactly
/// what "was this transaction's data silently altered" requires.
///
/// `patchData` is a full state SNAPSHOT at commit time (category name
/// included, frozen as it was then — the same historical-fact treatment
/// this app already gives Trade/Dividend fields), not a byte-level
/// diff/patch — a true reversible patch is only useful if you intend to
/// reverse it, which this feature deliberately does not do. The field is
/// still named `patchData` to keep the schema close to the original
/// request; it's read-only, display-only data for the audit timeline UI.
model LedgerCommit {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   NotableTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  action        LedgerCommitAction
  /// Null only for a transaction's very first (CREATE) commit.
  previousHash  String?
  /// SHA-256 hex digest of (previousHash ?? "") + a canonical JSON
  /// serialization of `patchData` — see src/lib/ledger-hash.ts.
  currentHash   String
  patchData     Json
  createdAt     DateTime           @default(now())

  @@index([userId, transactionId, createdAt])
}

/// Device-Bound Biometrics via Passkeys (ad hoc) — one registered
/// WebAuthn credential. Only the credential's PUBLIC half and bookkeeping
/// ever reach this table; the private key never leaves the authenticator,
/// and this app never sees, stores, or needs anything about the actual
/// biometric/PIN unlock a platform authenticator may use locally — only a
/// signature proving possession of the private key ever crosses the
/// network, by construction of the WebAuthn spec itself, not by any
/// control this app adds on top.
///
/// "Device-bound" is precise for a platform authenticator tied to one
/// specific device, but a passkey CAN be a synced, multi-device
/// credential (iCloud Keychain, Google Password Manager) — `deviceType`/
/// `backedUp` capture which kind this actually is, so Settings can state
/// that honestly instead of overclaiming "device-bound" for a credential
/// that may in fact be synced.
model Authenticator {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Base64url WebAuthn credential ID — generated by the authenticator
  /// itself, globally unique by the spec's own design (never scoped to
  /// this app), which is exactly what lets an AUTHENTICATION attempt
  /// (before any session/userId is known) resolve straight to the owning
  /// row and, from there, its user.
  credentialId String    @unique
  /// COSE-encoded public key bytes from registration.
  publicKey    Bytes
  /// Signature counter for clone detection. BigInt, not Int — a WebAuthn
  /// counter is a uint32, whose max value exceeds Int32's range.
  counter      BigInt
  /// "singleDevice" | "multiDevice", from @simplewebauthn/server's
  /// verifyRegistrationResponse (`credentialDeviceType`).
  deviceType   String
  /// True means this credential is backed up/synced (e.g. iCloud
  /// Keychain) — NOT strictly bound to only one device, despite this
  /// feature's own name; surfaced honestly in the UI rather than hidden.
  backedUp     Boolean
  transports   String[]
  /// User-editable label shown in Settings (e.g. "MacBook Touch ID") —
  /// never derived from anything the authenticator reports about itself,
  /// since WebAuthn intentionally exposes very little device-identifying
  /// information; defaults to a generic label at registration.
  deviceLabel  String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// A single-use WebAuthn ceremony challenge (registration or
/// authentication) — same "expires quickly, deleted immediately on
/// consumption, can never be replayed" shape as this app's other
/// single-use tokens (PasswordResetToken, EmailVerificationToken,
/// GroupInvite). An AUTHENTICATION challenge is necessarily created and
/// consumed for a caller with NO SESSION YET (that's the entire point of
/// a sign-in ceremony) — handled the same way every other pre-auth
/// bootstrap operation in this app is (src/server/auth/webauthn-admin-ops.ts,
/// the fifth narrow admin-client exception, same shape as
/// credentials.ts/account-recovery-admin-ops.ts), not by weakening this
/// table's own RLS policy, which stays the standard tenant_isolation
/// shape below for defense-in-depth on the REGISTRATION path (an
/// authenticated user adding a passkey from Settings), where a real
/// userId-scoped session already exists.
model Challenge {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      WebAuthnChallengeType
  /// The base64url challenge value @simplewebauthn/server generated and
  /// expects to see echoed back in the signed response.
  challenge String
  expiresAt DateTime
  createdAt DateTime              @default(now())

  @@index([userId, type])
}

/// EU Open Banking PSD2 Ingestion (ad hoc) — a link to a MOCK, simulated
/// European banking institution via a PSD2-shaped API. See
/// src/lib/banking/psd2-client.ts's own doc comment for the honest scope:
/// this models the SHAPE of a real Berlin Group NextGenPSD2-style
/// integration (a consent/access-token flow, account and transaction
/// endpoints, realistic error codes) for demonstration — there is no
/// real regulatory licensing, eIDAS certificate, or bank connectivity
/// behind it, and `institutionId` refers to one of `MOCK_INSTITUTIONS`,
/// never a real bank.
///
/// One `BankConnection` maps to exactly one `BankAccount` — a real
/// deliberate simplification: a genuine PSD2 consent can cover several
/// accounts at one institution, but this app has no per-connection
/// multi-account UI, and adding one wasn't part of this feature's actual
/// ask. The `BankAccount` row is created at connect time (not lazily at
/// first sync) so the connection has somewhere real to attach synced
/// transactions to immediately.
model BankConnection {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String
  bankAccountId String               @unique
  bankAccount   BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  /// Encrypted at rest — see file header. This mock token has no real
  /// value (nothing real ever accepts it), but is deliberately given the
  /// same at-rest protection a genuine PSD2 bearer token — a real
  /// credential granting live access to a user's actual bank data —
  /// would require, so this app's own code never demonstrates handling a
  /// credential-shaped value more casually than production code should.
  accessToken   String
  expiresAt     DateTime
  status        BankConnectionStatus @default(ACTIVE)
  lastSyncedAt  DateTime?
  createdAt     DateTime             @default(now())

  @@index([userId])
}

/// Vercel Cron & Notifications Engine (ad hoc) — durable, dismissable
/// alerts surfaced in the dashboard header's notification bell.
/// `type` is a plain string (not an enum) rather than a fixed catalog,
/// since the two scheduled jobs that could plausibly write here today
/// (`src/app/api/cron/route.ts`'s FX/crypto sync and Dead Man's Switch
/// checks) don't yet create rows here themselves — this pass builds the
/// read/dismiss surface the task asked for, not a producer wired to every
/// possible event source; see that route's own doc comment for why.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

/// MFA backup codes (Phase 3, Security & Recovery). Only `codeHash`
/// (SHA-256 of the raw code — src/server/auth/recovery-codes.ts) is ever
/// persisted, the same "hash it, never store the secret" rule already
/// established for `PasswordResetToken.tokenHash`/`GroupInvite.tokenHash`/
/// `Beneficiary.shareHash`. The raw code exists only in the one-time
/// setup response the client is expected to save; a database dump reveals
/// no usable code. `used` (not a `usedAt` timestamp) is deliberately all
/// this model tracks beyond that — the task's own stated field list, and
/// there's no feature here that needs to know WHEN a code was redeemed,
/// only whether it still can be.
model RecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String   @unique
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, used])
}
