// PFW data model.
//
// Security invariants that hold for every user-scoped model below (see
// AGENTS.md and docs/SECURITY.md for the full rationale):
//  - every user-owned row carries its own `userId` column directly (not
//    just via a parent relation), so the DAL can enforce `where: { userId }`
//    on any table without a join.
//  - Postgres Row-Level Security policies (prisma/migrations/*_rls_and_runtime_role)
//    enforce the same scoping as defense-in-depth, keyed on the session
//    variable `app.current_user_id`.
//  - fields marked "encrypted at rest" below are ciphertext (AES-256-GCM)
//    at the storage layer, transparently encrypted/decrypted by the Prisma
//    Client extension in src/server/db/encrypted-fields.ts — the schema
//    type is still String because encryption happens above this layer.
//
// MerchantEmbedding is user-scoped even though the spec calls it a "shared"
// cache — see AGENTS.md for why the more conservative (per-user) reading
// was chosen given the blanket "all tables are strictly scoped to a user
// ID" rule stated in the same spec section.
//
// ExchangeRate is the opposite deviation, deliberately NOT user-scoped —
// it holds no user data at all (public daily FX rates), so RLS/tenant
// scoping doesn't apply to it. See its own model comment.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
}

enum DebtType {
  CREDIT_CARD
  MORTGAGE
  PERSONAL_LOAN
  AUTO_LOAN
  STUDENT_LOAN
  OTHER
}

enum AssetType {
  PROPERTY
  VEHICLE
  CRYPTO
  PENSION
  KEREN_HISHTALMUT
  OTHER
}

enum TradeSide {
  BUY
  SELL
}

/// AGENTS.md §3k: multi-currency amendment to the original single-ILS law.
/// ILS remains the app's one base/reporting currency; the other three are
/// "native" currencies a BankAccount/NotableTransaction/PortfolioHolding/
/// Trade can be denominated in.
enum Currency {
  ILS
  USD
  EUR
  GBP
}

/// What kind of instrument a PortfolioHolding is. Drives the portfolio
/// module's allocation breakdown and, more importantly, dividend
/// expectations: CRYPTO never pays a dividend, so a zero yield there is
/// correct rather than missing data.
enum AssetClass {
  STOCK
  ETF
  CRYPTO
}

/// ANNOUNCED = declared but not yet paid (the upcoming-payout schedule);
/// PAID = money actually received. The distinction is what decides
/// whether the payout amount is *stored* (a historical fact) or *derived*
/// live from today's position — see the Dividend model comment.
enum DividendStatus {
  ANNOUNCED
  PAID
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// A SharedGroup member's standing. OWNER is exactly the group's creator
/// (there is only ever one — see `createSharedGroup`'s doc comment) and
/// always has implicit write access regardless of `permission`; every
/// other member is MEMBER, whose write access is governed by
/// `GroupMember.permission` alone.
enum GroupRole {
  OWNER
  MEMBER
}

/// Read = can see a resource shared into the group. Write = can also
/// edit it. Granted per-membership (one level per person per group), not
/// per-resource-per-person — see AGENTS.md §3s for why a full per-resource
/// ACL matrix was deliberately not built.
enum SharePermission {
  READ
  WRITE
}

/// PENDING -> ACCEPTED (normal path) or REVOKED (owner cancels it early)
/// or EXPIRED (past `expiresAt`, checked at accept time rather than by a
/// background job — see `acceptGroupInvite`'s doc comment).
enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DeadMansSwitchStatus {
  ACTIVE
  GRACE_PERIOD
  TRIGGERED
  RECOVERED
}

/// `zk*` columns back the zero-knowledge vault for `GoalContribution.note`
/// (AGENTS.md §3m) — none of them are secret. `zkSalt` and
/// `zkKdfIterations` are PBKDF2 parameters (a salt's job is to be public;
/// the iteration count is stored per-user rather than hardcoded so a
/// future stronger default doesn't invalidate already-derived keys).
/// `zkCanaryCiphertext` is a known constant encrypted under the derived
/// key — verifying a re-entered passphrase means attempting to decrypt
/// this, which reveals nothing about the passphrase itself. All three
/// null = the vault has never been set up (the universal fallback state
/// for every existing user, since this is a new, opt-in feature — see
/// §3m's migration path for what happens to notes written before it
/// existed). This app has no passphrase-rotation flow: once set up, these
/// three columns are immutable — see `setupZkVault`'s doc comment.
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  displayName        String
  zkSalt             String?
  zkKdfIterations    Int?
  zkCanaryCiphertext String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bankAccounts             BankAccount[]
  categories               Category[]
  transactions             NotableTransaction[]
  budgets                  Budget[]
  goals                    Goal[]
  goalContributions        GoalContribution[]
  debts                    Debt[]
  debtPayments             DebtPayment[]
  manualAssets             ManualAsset[]
  portfolioHoldings        PortfolioHolding[]
  trades                   Trade[]
  netWorthSnapshots        NetWorthSnapshot[]
  merchantEmbeddings       MerchantEmbedding[]
  dividends                Dividend[]
  subscriptionTracking     SubscriptionTracking[]
  auditLogs                AuditLog[]
  sharedGroupsCreated      SharedGroup[]             @relation("SharedGroupsCreated")
  groupMemberships         GroupMember[]
  groupInvitesCreated      GroupInvite[]             @relation("GroupInvitesCreated")
  groupInvitesAccepted     GroupInvite[]             @relation("GroupInvitesAccepted")
  deadMansSwitch           DeadMansSwitch?
  beneficiaries            Beneficiary[]
  emergencyDocuments       EmergencyDocument[]
  recoveryShareSubmissions RecoveryShareSubmission[]
}

/// Cryptographic Dead Man's Switch (AGENTS.md §3t) — one row per user,
/// protecting a dedicated "Emergency Vault" of `EmergencyDocument` rows.
///
/// This is deliberately a SEPARATE vault with its OWN master key, not an
/// extension of the zero-knowledge goal-notes vault above (`User.zk*`,
/// §3m): that vault's derived key is created with `extractable: false`
/// specifically so it can never be exported from the browser, by design.
/// Splitting a key via Shamir's Secret Sharing fundamentally requires
/// exporting its raw bytes at setup time — doing that to the zk-vault key
/// would silently undermine the one property it exists for. This vault's
/// key (`vaultSalt`/`vaultKdfIterations`, derived in
/// src/lib/dead-mans-switch-crypto.ts) is deliberately extractable for
/// exactly as long as setup takes, then immediately split into
/// `totalShares` Shamir shares and discarded — the server never stores
/// the raw key or any share (see Beneficiary's `shareHash`).
/// `vaultCanaryCiphertext` is the same "encrypt a known constant, verify
/// by attempting to decrypt it" pattern as `User.zkCanaryCiphertext` —
/// used both by the owner (confirming their recovery passphrase still
/// works) and, critically, by the server during recovery to confirm a
/// set of combined shares reconstructed the CORRECT key before it ever
/// attempts to decrypt a real document.
///
/// `status` lifecycle: ACTIVE -> GRACE_PERIOD (inactivity threshold
/// crossed) -> TRIGGERED (grace period also elapsed — the recovery portal
/// opens for beneficiaries) -> RECOVERED (threshold shares combined
/// successfully). GRACE_PERIOD reverts to ACTIVE automatically on any
/// activity (src/server/auth/current-user.ts's activity touch); TRIGGERED
/// does NOT auto-revert on activity — a switch already open for recovery
/// requires an explicit owner action (`cancelRecovery`) rather than a
/// passive page load, so an incidental API call mid-recovery can't
/// silently undo beneficiaries' already-submitted shares. See
/// AGENTS.md §3t for the full design rationale.
model DeadMansSwitch {
  id                      String               @id @default(cuid())
  userId                  String               @unique
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                  DeadMansSwitchStatus @default(ACTIVE)
  inactivityThresholdDays Int                  @default(90)
  gracePeriodDays         Int                  @default(14)
  lastActivityAt          DateTime             @default(now())
  graceStartedAt          DateTime?
  triggeredAt             DateTime?
  recoveredAt             DateTime?
  /// N — total number of Shamir shares generated at setup.
  totalShares             Int
  /// M — shares required to reconstruct the master key (M <= N).
  thresholdShares         Int
  /// PBKDF2 salt — public by design, see zkSalt's comment above for why.
  vaultSalt               String
  vaultKdfIterations      Int
  vaultCanaryCiphertext   String
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  beneficiaries    Beneficiary[]
  documents        EmergencyDocument[]
  shareSubmissions RecoveryShareSubmission[]

  @@index([status])
}

/// One row per Shamir share slot (`shareIndex` 1..totalShares). The raw
/// share VALUE is never persisted anywhere in this app — only
/// `shareHash` (SHA-256 hex of the raw share bytes, computed client-side
/// at setup), which lets the recovery portal verify a beneficiary's
/// submitted share belongs to this slot without the server ever needing
/// to already hold it. `inviteTokenHash` is the standard "hash it, never
/// store the secret" treatment `GroupInvite.tokenHash` already uses
/// (§3s) — the raw token (which page to visit) and the raw share value
/// (the actual secret) are shown to the owner together exactly once at
/// setup, then distributed out-of-band to two different real-world
/// channels by convention (e.g. the token by email, the share on paper) —
/// the app is never in a position to leak both at once after that
/// moment, because it never stores either of them again.
model Beneficiary {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadMansSwitchId String
  deadMansSwitch   DeadMansSwitch @relation(fields: [deadMansSwitchId], references: [id], onDelete: Cascade)
  label            String
  shareIndex       Int
  shareHash        String
  inviteTokenHash  String         @unique
  createdAt        DateTime       @default(now())

  submissions RecoveryShareSubmission[]

  @@unique([deadMansSwitchId, shareIndex])
  @@index([userId])
  @@index([deadMansSwitchId])
}

/// An emergency document — arbitrary free text (account instructions,
/// asset locations, final wishes, etc.) AES-256-GCM encrypted entirely
/// client-side (src/lib/dead-mans-switch-crypto.ts, "dms1:" format)
/// under the vault's master key before ever reaching the server. Same
/// zero-knowledge-at-rest property `GoalContribution.note` has (§3m) —
/// the crucial difference (see DeadMansSwitch's model comment) is that
/// THIS key is designed to eventually be reconstructed and used
/// server-side exactly once, during a successful recovery.
model EmergencyDocument {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadMansSwitchId String
  deadMansSwitch   DeadMansSwitch @relation(fields: [deadMansSwitchId], references: [id], onDelete: Cascade)
  title            String
  ciphertext       String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([deadMansSwitchId])
}

/// A beneficiary's submitted share during an active recovery (only
/// accepted while `DeadMansSwitch.status = TRIGGERED`).
/// `shareValueCiphertext` is the raw share value, encrypted at rest under
/// the app-wide field-encryption codec (src/server/crypto/field-encryption.ts
/// — the same codec `NotableTransaction.description` uses), deliberately
/// NOT a zero-knowledge value: reconstructing the master key fundamentally
/// requires the server to combine >= threshold shares together in one
/// place at some point, which is a one-time, narrowly-scoped, DOCUMENTED
/// server-side exposure — the same honest treatment
/// `findLegacyNoteContributions` gives its own unavoidable exposure
/// (§3m), never pretended to be zero-knowledge. Field-level encryption
/// here is defense-in-depth against a raw database dump between
/// submissions, not a claim that the server can never combine them.
model RecoveryShareSubmission {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadMansSwitchId     String
  deadMansSwitch       DeadMansSwitch @relation(fields: [deadMansSwitchId], references: [id], onDelete: Cascade)
  beneficiaryId        String
  beneficiary          Beneficiary    @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  shareValueCiphertext String
  submittedAt          DateTime       @default(now())

  @@unique([deadMansSwitchId, beneficiaryId])
  @@index([userId])
  @@index([deadMansSwitchId])
}

/// User-defined categories with permanent slugs: renaming changes `name`
/// only, `slug` never changes once created, so rules/links keyed on it
/// survive a rename. Every user gets exactly one `isUncategorized` row at
/// seed/user-creation time — deleting a category reassigns its
/// transactions to that row before the delete (enforced at the DAL layer;
/// the DB does not cascade-delete transactions when a category is
/// removed, precisely so a skipped reassignment step fails loudly instead
/// of silently orphaning transactions).
///
/// `sharedGroupId` (AGENTS.md §3s) is nullable and additive: `userId`
/// always stays the true owner (a category is never transferred), and
/// setting `sharedGroupId` only extends *visibility* (and, for a WRITE
/// member, editability of `name`) to the rest of that SharedGroup — never
/// its `transactions`, which stay strictly personal regardless of
/// sharing (see SharedGroup's own model comment).
model Category {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  isUncategorized Boolean      @default(false)
  archivedAt      DateTime?
  sharedGroupId   String?
  sharedGroup     SharedGroup? @relation(fields: [sharedGroupId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  transactions       NotableTransaction[]
  budgets            Budget[]
  merchantEmbeddings MerchantEmbedding[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([sharedGroupId])
}

/// Credit balances are stored positive = money owed (a $500 credit card
/// balance is `nativeBalance = 50000`, not `-50000`).
///
/// `nativeBalance` is the account's own currency's minor units — the only
/// balance actually stored. There is deliberately no stored ILS-agorot
/// mirror: a live balance's base-currency value moves every time the FX
/// rate does, so storing one would immediately go stale (a "derived
/// truth" violation, AGENTS.md law #5). The DAL computes the ILS
/// equivalent at read time from the latest `ExchangeRate` row, the same
/// "today is live, never stored" treatment NetWorthSnapshot already gets.
/// `sharedGroupId` (AGENTS.md §3s) extends visibility of this row itself
/// (balance, institution, nickname) to the SharedGroup's members — a
/// household's joint checking account can show its shared balance for a
/// household net-worth view. `transactions` are deliberately NOT included
/// in that grant: NotableTransaction keeps its own strictly-personal RLS
/// policy untouched regardless of whether the account it posted to is
/// shared, so a shared account's balance is visible without exposing the
/// owner's individual line-item spending — the "personal asset vaults
/// stay strictly isolated" half of the feature.
model BankAccount {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionName String
  /// Encrypted at rest — see file header.
  last4           String
  accountType     BankAccountType
  nickname        String?
  currency        Currency        @default(ILS)
  /// Minor units of `currency` (agorot if ILS, cents otherwise).
  nativeBalance   BigInt
  sharedGroupId   String?
  sharedGroup     SharedGroup?    @relation(fields: [sharedGroupId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  transactions NotableTransaction[]

  @@index([userId])
  @@index([sharedGroupId])
}

/// The ledger. `providerTransactionId` is the CSV/bank-provided reference
/// used for idempotent upserts on re-import; it's null for manually
/// entered transactions, and Postgres treats multiple NULLs in a unique
/// constraint as non-colliding, so manual entries never fight each other
/// over uniqueness. `amount`/`nativeAmount` are signed: negative =
/// expense, positive = income/credit.
///
/// `amount` (ILS agorot) and `exchangeRateAtEntry` are historical facts
/// captured ONCE, at entry/import time — like Trade.totalAgorot, a past
/// transaction's ILS equivalent isn't a "derived truth" violation to
/// store, because re-deriving it later with today's rate would silently
/// rewrite history every time FX rates move. `nativeAmount` is the
/// original ledger fact exactly as it appeared on the native
/// statement/CSV/form. For an ILS-native transaction, `amount ===
/// nativeAmount` and `exchangeRateAtEntry` is null (rate is trivially 1,
/// no real conversion happened).
model NotableTransaction {
  id                    String      @id @default(cuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccountId         String
  bankAccount           BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  categoryId            String
  category              Category    @relation(fields: [categoryId], references: [id])
  providerTransactionId String?
  occurredAt            DateTime
  postedAt              DateTime?
  currency              Currency    @default(ILS)
  /// Minor units of `currency`, signed.
  nativeAmount          BigInt
  /// ILS agorot equivalent, signed — see model comment.
  amount                BigInt
  /// ILS per 1 unit of `currency` at entry time. Null when currency = ILS.
  exchangeRateAtEntry   Decimal?    @db.Decimal(12, 6)
  /// Encrypted at rest — untrusted free text, see file header and
  /// docs/SECURITY.md §3.4 (indirect prompt injection surface).
  description           String
  merchantName          String?
  isManual              Boolean     @default(false)
  needsReview           Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([userId, providerTransactionId])
  @@index([userId, occurredAt])
  @@index([userId, categoryId])
  @@index([userId, bankAccountId])
}

/// One row per (user, category) — the current monthly limit. Utilization
/// and month-progress proration are computed live by the DAL, never
/// stored.
/// `sharedGroupId` (AGENTS.md §3s): nullable, additive — `userId` always
/// stays the true owner/creator, sharing only extends visibility (and,
/// for a WRITE-permission member, editability of `monthlyLimit`) to the
/// rest of the group.
model Budget {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Agorot.
  monthlyLimit  BigInt
  sharedGroupId String?
  sharedGroup   SharedGroup? @relation(fields: [sharedGroupId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, categoryId])
  @@index([sharedGroupId])
}

/// Progress is derived from `contributions`, never stored on this model —
/// the "derived truth" law.
model Goal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  /// Agorot.
  targetAmount BigInt
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contributions GoalContribution[]

  @@index([userId])
}

/// Signed: positive = contribution, negative = withdrawal.
model GoalContribution {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId        String
  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// Agorot, signed.
  amount        BigInt
  contributedAt DateTime
  /// Zero-knowledge ciphertext (AGENTS.md §3m) — a "zk1:iv:ciphertext"
  /// blob produced entirely client-side by src/lib/zk-crypto.ts under a
  /// key derived from the user's master passphrase. NOT covered by the
  /// server-side field-encryption extension (src/server/db/encrypted-fields.ts)
  /// — the server stores and returns this opaque string as-is and can
  /// never decrypt it, which is the entire point. A value still in the
  /// OLD "v1:iv:tag:ciphertext" format (field-encryption.ts) is a
  /// pre-migration legacy row — see zk-vault.ts's migration path.
  note          String?
  createdAt     DateTime @default(now())

  @@index([userId, goalId])
}

model Debt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  debtType       DebtType
  /// Agorot, positive = amount owed.
  currentBalance BigInt
  /// Basis points.
  aprBps         Int
  /// Agorot.
  minimumPayment BigInt
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments DebtPayment[]

  @@index([userId])
}

/// `principalPortion`/`interestPortion` are nullable because the Phase 3
/// debt-math engine computes the split; a payment can be recorded before
/// that breakdown is known.
model DebtPayment {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  debtId           String
  debt             Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  /// Agorot.
  amount           BigInt
  /// Agorot.
  principalPortion BigInt?
  /// Agorot.
  interestPortion  BigInt?
  paidAt           DateTime
  createdAt        DateTime @default(now())

  @@index([userId, debtId])
}

/// Off-feed assets (property, vehicles, crypto, pension/Keren Hishtalmut).
/// Valuation freshness (Fresh/Aging/Stale) is derived from `valuedAt` at
/// read time, never stored. `taxAdvantaged`/`liquidityDate` exist mainly
/// for KEREN_HISHTALMUT, which has a real 6-year liquidity lock-in under
/// Israeli law.
model ManualAsset {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  assetType     AssetType
  /// Agorot.
  currentValue  BigInt
  valuedAt      DateTime
  taxAdvantaged Boolean   @default(false)
  liquidityDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

/// `quantity` uses Decimal (not the Agorot integer primitive) because
/// share counts, not money, are the quantity here — fractional shares are
/// legitimate and Decimal/numeric is the correct fixed-precision type for
/// them. `totalCostBasis` is the total agorot invested in the current
/// position; weighted-average cost per share is derived at read time
/// (`totalCostBasis / quantity`), never stored, again per "derived truth".
///
/// `nativeCostBasis` is the same total, in the instrument's native
/// currency (`currency`, USD for every mock symbol today) — both are
/// historical accumulations of Trade.totalAgorot/nativeTotalAgorot, so
/// keeping both is consistent with those being stored historical facts,
/// not a re-derivable aggregate stored twice.
model PortfolioHolding {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol          String
  assetClass      AssetClass @default(STOCK)
  quantity        Decimal    @db.Decimal(20, 8)
  currency        Currency   @default(USD)
  /// Agorot.
  totalCostBasis  BigInt
  /// Minor units of `currency`.
  nativeCostBasis BigInt
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  trades    Trade[]
  dividends Dividend[]

  @@unique([userId, symbol])
}

/// The order blotter. `symbol` is denormalized from the holding for
/// blotter display without a join. `totalAgorot` is the historical
/// execution record (quantity × price, rounded once at execution time) —
/// storing it is not a "derived truth" violation, since a completed
/// trade's own total is a historical fact like a ledger entry, not a
/// rederivable aggregate. `idempotencyKey` backs the Idempotency-Key
/// header requirement on trade submission (Section 2.4).
///
/// Every ILS (`*Agorot`) figure here has a native-currency counterpart
/// (`native*`, USD minor units for every mock symbol today) plus
/// `exchangeRateAtEntry` — the rate actually used for this execution's
/// conversion, captured once and never recomputed, making explicit and
/// auditable what was previously only an implicit constant in
/// mock-market-data.ts (AGENTS.md §3k).
model Trade {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioHoldingId  String
  portfolioHolding    PortfolioHolding @relation(fields: [portfolioHoldingId], references: [id], onDelete: Cascade)
  symbol              String
  side                TradeSide
  quantity            Decimal          @db.Decimal(20, 8)
  currency            Currency         @default(USD)
  /// Agorot, price per share at execution.
  priceAgorot         BigInt
  /// Agorot.
  totalAgorot         BigInt
  /// Agorot, SELL only. The weighted-average cost basis at the moment of
  /// sale isn't reconstructable later without replaying the full trade
  /// history, so this is captured once, at execution time, like
  /// `totalAgorot` — a historical fact, not a "derived truth" violation.
  realizedPnlAgorot   BigInt?
  /// Minor units of `currency`, price per share at execution.
  nativePriceAmount   BigInt
  /// Minor units of `currency`.
  nativeTotalAmount   BigInt
  /// Minor units of `currency`, SELL only — see `realizedPnlAgorot`.
  nativeRealizedPnl   BigInt?
  /// ILS per 1 unit of `currency`, used for this execution's conversion.
  exchangeRateAtEntry Decimal          @db.Decimal(12, 6)
  executedAt          DateTime
  idempotencyKey      String?
  createdAt           DateTime         @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, executedAt])
}

/// Historical only — "today" is always computed live by the DAL, never
/// read from this table.
model NetWorthSnapshot {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotDate           DateTime @db.Date
  /// Agorot.
  totalAssetsAgorot      BigInt
  /// Agorot.
  totalLiabilitiesAgorot BigInt
  /// Agorot.
  netWorthAgorot         BigInt
  createdAt              DateTime @default(now())

  @@unique([userId, snapshotDate])
}

/// 384-dimension embedding cache for merchant-name categorization (Tier 3
/// KNN, Phase 3). Stored as a native float array rather than a pgvector
/// column for now — Phase 3's KNN engine can do cosine similarity in
/// application code at this data scale; revisit if that becomes a
/// bottleneck.
///
/// `categoryId` was added in the Self-Learning Vector Categorization
/// Engine pass (AGENTS.md §3u) — this table had NEVER been read or
/// written anywhere in the app before that pass (confirmed by grep, not
/// assumed), so adding a required column here is not a backward-
/// compatibility concern; there was no existing data to migrate. Every
/// row is a "correction": one (user, merchant) pair's confirmed
/// category, refreshed via upsert every time the user recategorizes a
/// transaction for that merchant — see `upsertMerchantEmbedding`'s doc
/// comment for why this is an upsert, not an append-only log.
/// `onDelete: Cascade` on `category` matches `Budget.categoryId`'s
/// existing precedent: a hard-deleted category (not merely archived —
/// see `deleteCategoryWithReassignment`) makes any embedding correction
/// pointing at it meaningless.
model MerchantEmbedding {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantKey        String
  sampleMerchantName String
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  embedding          Float[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, merchantKey])
  @@index([categoryId])
}

/// A dividend declared on a holding the user owns.
///
/// The stored-vs-derived split here is deliberate and follows the same
/// rule as Trade vs. BankAccount (AGENTS.md law #5):
///  - `status = PAID` — the payout already happened, so the amount
///    actually received (`totalNativeAmount`/`totalAgorot`), the share
///    count it was paid on (`quantityAtPayment`), and the FX rate used
///    (`exchangeRateAtEntry`) are historical facts, captured once. They
///    are NOT recomputed later: the position and the rate both move, and
///    re-deriving would silently rewrite history.
///  - `status = ANNOUNCED` — the payout hasn't happened yet, so those
///    four columns are null and the projected amount is computed live
///    from today's quantity and today's rate. Storing a projection would
///    go stale the moment either changed.
///
/// `amountPerShareNative` is the declared per-share rate, which is a fact
/// about the *instrument* rather than the position, so it is stored for
/// both statuses.
model Dividend {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioHoldingId   String
  portfolioHolding     PortfolioHolding @relation(fields: [portfolioHoldingId], references: [id], onDelete: Cascade)
  /// Denormalized from the holding, same reason as Trade.symbol — blotter/
  /// schedule display without a join.
  symbol               String
  currency             Currency         @default(USD)
  /// Minor units of `currency`, per single share. Declared rate.
  amountPerShareNative BigInt
  /// The date the holding must be owned by to qualify.
  exDate               DateTime
  /// The date the cash actually lands.
  payDate              DateTime
  status               DividendStatus   @default(ANNOUNCED)
  /// PAID only — shares held when the dividend was paid.
  quantityAtPayment    Decimal?         @db.Decimal(20, 8)
  /// PAID only — minor units of `currency` actually received.
  totalNativeAmount    BigInt?
  /// PAID only — ILS agorot actually received.
  totalAgorot          BigInt?
  /// PAID only — ILS per 1 unit of `currency` at payment.
  exchangeRateAtEntry  Decimal?         @db.Decimal(12, 6)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([userId, symbol, exDate])
  @@index([userId, payDate])
  @@index([userId, portfolioHoldingId])
}

/// Daily ILS exchange rates, fetched by the background sync service
/// (src/server/currency/, AGENTS.md §3k). Deliberately NOT user-scoped or
/// RLS-protected — exchange rates are public market data belonging to no
/// user, so the blanket per-user scoping convention (see this file's
/// header) doesn't apply, the same way MerchantEmbedding's per-user
/// scoping was a deliberate deviation in the opposite direction. ILS
/// itself never gets a row here — its rate against itself is always
/// exactly 1 and never looked up (see exchange-rate.ts's IDENTITY_RATE).
///
/// `rate` is ILS per 1 unit of `currency`. Stored as Decimal rather than
/// an integer "micros" column: Prisma/Postgres's Decimal is already exact
/// base-10 arithmetic (backed by decimal.js, not IEEE754 float), so there
/// is no float-drift risk here to guard against with a bespoke integer
/// scaling trick the way agorot/basis-points do for actual money — see
/// src/lib/exchange-rate.ts, which treats a rate as a plain finite
/// `number` ratio at the application layer (same reasoning as
/// money.ts's `multiplyAgorot`'s `factor` parameter).
model ExchangeRate {
  id        String   @id @default(cuid())
  currency  Currency
  /// ILS per 1 unit of `currency`.
  rate      Decimal  @db.Decimal(12, 6)
  asOfDate  DateTime @db.Date
  source    String
  fetchedAt DateTime @default(now())

  @@unique([currency, asOfDate])
  @@index([currency, asOfDate])
}

enum SubscriptionReviewStatus {
  ACTIVE
  REVIEWED
  CANCELLED
}

/// Per-user, per-merchant subscription review state (AGENTS.md §3p) — the
/// stateful half of the subscription radar. `merchantKey` is the radar's
/// *canonical* fuzzy-cluster key (src/lib/subscription-radar.ts), not a
/// raw per-transaction merchantKey — a subscription billed under several
/// slightly different descriptor strings still has exactly one review
/// status, keyed on whichever raw string the radar picked as canonical
/// for that cluster. A row only exists once a user has explicitly
/// reviewed or cancelled something; a merchant with no row here is
/// implicitly ACTIVE — see `getSubscriptionStatuses`'s doc comment for
/// why that default lives in the DAL, not as a `@default` here.
model SubscriptionTracking {
  id          String                   @id @default(cuid())
  userId      String
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantKey String
  status      SubscriptionReviewStatus
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([userId, merchantKey])
  @@index([userId])
}

/// A household/shared space (AGENTS.md §3s). Owns nothing itself — it's a
/// scoping boundary that specific Budget/BankAccount/Category rows opt
/// into via their own nullable `sharedGroupId`, never a container that
/// copies or duplicates data. `NotableTransaction` and every other
/// personal model (Goal, Debt, ManualAsset, PortfolioHolding, ...) have
/// no `sharedGroupId` at all and stay strictly single-user, by omission
/// — "personal asset vaults stay strictly isolated" is enforced by which
/// models this feature touches, not by a runtime check.
///
/// `createdById` is the group's one OWNER — ownership never transfers in
/// this pass (no "make someone else the owner" flow); deleting the owner
/// cascades away the whole group and every share grant on it (a shared
/// Budget/BankAccount/Category row itself survives via `onDelete:
/// SetNull` on `sharedGroupId` — only the *sharing* is undone, not the
/// underlying resource, which still belongs to whichever member actually
/// owns it).
model SharedGroup {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdBy   User     @relation("SharedGroupsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      GroupMember[]
  invites      GroupInvite[]
  budgets      Budget[]
  bankAccounts BankAccount[]
  categories   Category[]

  @@index([createdById])
}

/// One row per (user, group) — the only way a GroupMember row is ever
/// created is a user accepting their own invite (or the owner creating
/// their own OWNER row at group-creation time), both of which are a
/// self-insert of `userId = <the acting user>`. There is deliberately no
/// "owner directly adds someone" path — see `createGroupInvite`'s doc
/// comment. `permission` is read by MEMBER rows only; an OWNER row's
/// permission is always implicitly WRITE regardless of this column's
/// value (see the RLS helper functions in the migration this model
/// shipped with).
model GroupMember {
  id            String          @id @default(cuid())
  sharedGroupId String
  sharedGroup   SharedGroup     @relation(fields: [sharedGroupId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          GroupRole       @default(MEMBER)
  permission    SharePermission @default(READ)
  joinedAt      DateTime        @default(now())

  @@unique([sharedGroupId, userId])
  @@index([userId])
}

/// A pending invitation to join a SharedGroup. `tokenHash` is a SHA-256
/// hash of a single-use random token generated in
/// `src/server/dal/shared-groups.ts` — the raw token is returned to the
/// inviter exactly once (to send out-of-band: email, a shared link) and
/// is never itself persisted, the same "hash it, never store the secret"
/// treatment a real password would get if this app had one yet (and
/// exactly the treatment `zk-crypto.ts`'s canary already gives a
/// passphrase, §3m). A row's `status` moves PENDING -> ACCEPTED/REVOKED
/// once; EXPIRED is assigned lazily at accept-time when `expiresAt` has
/// passed rather than by a background sweep (see `acceptGroupInvite`).
model GroupInvite {
  id            String          @id @default(cuid())
  sharedGroupId String
  sharedGroup   SharedGroup     @relation(fields: [sharedGroupId], references: [id], onDelete: Cascade)
  invitedEmail  String
  tokenHash     String          @unique
  permission    SharePermission @default(READ)
  status        InviteStatus    @default(PENDING)
  expiresAt     DateTime
  createdById   String
  createdBy     User            @relation("GroupInvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedById  String?
  acceptedBy    User?           @relation("GroupInvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([sharedGroupId])
  @@index([invitedEmail])
}

/// Append-only. Nothing in the application ever calls `.update()` or
/// `.delete()` on this model — enforced additionally at the DB level by a
/// trigger (prisma/migrations/*_rls_and_runtime_role) that rejects UPDATE
/// and DELETE on this table outright.
model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  action     AuditAction
  beforeData Json?
  afterData  Json?
  occurredAt DateTime    @default(now())

  @@index([userId, entityType, entityId])
  @@index([userId, occurredAt])
}
