{
  "name": "pfw",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "verify:client-bundle-secrets": "tsx --conditions=react-server scripts/check-no-secrets-in-client-bundle.ts",
    "sync:rates": "tsx --conditions=react-server scripts/sync-exchange-rates.ts",
    "check:dead-mans-switch": "tsx --conditions=react-server scripts/check-dead-mans-switch.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
