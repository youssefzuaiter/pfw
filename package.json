    "@prisma/client": "^7.10.0",
    "@react-three/fiber": "^9.7.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
