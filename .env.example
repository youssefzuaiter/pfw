# Copy to .env for local development. Never commit real secrets.
# Both Next.js and the Prisma CLI (via `import "dotenv/config"` in
# prisma.config.ts) read plain `.env`.

# Admin/migration connection (the pfw_app superuser role) — used only by
# `prisma migrate` / `prisma db seed`. Application code must never use this.
# Matches compose.yaml's postgres service.
DATABASE_URL="postgresql://pfw_app:pfw_local_dev_password@localhost:5433/pfw_local?schema=public"

# Application runtime connection (the restricted pfw_runtime role, subject
# to Row-Level Security) — this is what the app's PrismaClient actually
# uses. Created by prisma/migrations/*_rls_and_runtime_role.
APP_DATABASE_URL="postgresql://pfw_runtime:pfw_runtime_dev_password@localhost:5433/pfw_local?schema=public"

# AES-256-GCM field-level encryption key: 32 random bytes, base64-encoded.
# Generate a fresh one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Leave unset. Only set this to rotate ENCRYPTION_KEY without corrupting
# every already-encrypted row — see docs/SECURITY-CHECKLIST.md's "Secret
# rotation & storage guidelines" for the full procedure. Same format as
# ENCRYPTION_KEY (32 random bytes, base64). Once set, every NEW write
# lands on this key immediately and GET /api/cron's nightly sweep (also
# runnable by hand: npm run rotate:encryption-key) re-encrypts existing
# rows onto it. When the cron response's encryptionKeyRotation block
# reports remaining: 0, check that its nextKeyId matches the fingerprint
# of YOUR saved copy of this key (printf '%s' "$KEY" | base64 -d |
# shasum -a 256 | cut -c1-12), then set ENCRYPTION_KEY to this same
# value and remove ENCRYPTION_KEY_NEXT — the rotation is then complete.
ENCRYPTION_KEY_NEXT=""

# Server-side only. Never referenced with a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=""

# Auth.js session JWT signing/encryption key (AGENTS.md §3ff) — at least
# 32 random characters. Generate a fresh one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Not a secret — the merchant-embedding sidecar's local address (see
# sidecar/). Defaults to this value even if unset, so it's optional.
EMBEDDING_SIDECAR_URL="http://localhost:8001"

# Not a secret — the local-LLM copilot's Ollama endpoint (AGENTS.md §3o).
# Both default even if unset. Requires Ollama running locally
# (https://ollama.com) with a tool-calling-capable model pulled, e.g.
# `ollama pull llama3.1`. Must resolve to a loopback/private address —
# the copilot refuses to run against anything else.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Real transactional email (auth hardening pass, ad hoc post-§3ff) —
# password-reset and email-verification links, sent via Resend
# (https://resend.com — free tier, no domain verification needed to send
# from their shared onboarding@resend.dev sender). Get an API key from
# https://resend.com/api-keys. Only ever read lazily, at the moment an
# email actually needs to send — see src/server/env.ts's own doc comment.
RESEND_API_KEY=""

# Not a secret. Defaults to Resend's shared testing sender if unset —
# swap to a verified custom domain's address for a real deployment.
RESEND_FROM_EMAIL="PFW <onboarding@resend.dev>"

# Not a secret — this app's own public origin, used only to build
# absolute links inside outbound emails (a link in an email has to be a
# full URL). Defaults to the local dev server if unset.
APP_URL="http://localhost:3000"

# Not a secret. Where GET /api/cron sends its one-email-per-run operator
# alert when a nightly job fails (FX/crypto/equity-quote sync, the Dead
# Man's Switch inactivity check, the rate-limit sweep) or the stale-data
# breaker trips. Sent through the same Resend client as auth emails, so
# RESEND_API_KEY must be set for it to actually go out. Leave empty to
# disable — the cron response still reports every failure either way.
# See AGENTS.md §3yy.
OPERATOR_ALERT_EMAIL=""

# Vercel Cron & Notifications Engine (ad hoc) — src/app/api/cron/route.ts
# checks this against the `Authorization: Bearer <CRON_SECRET>` header
# Vercel automatically sends on a Cron-triggered request once this env
# var is set on the project. Only needed for a real Vercel deployment
# running vercel.json's scheduled job; unset locally is fine, since
# nothing else ever calls this route. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
CRON_SECRET=""

# Tier 3 scaffolding only (docs/SECURITY.md §1) — no bank-integration
# feature reads these yet; src/server/env.ts's getBankApiCredentials()
# exists purely so the env-var contract is decided ahead of time. Leave
# all three unset for Tier 2 (the expected state today). If set, all
# three must be set together — a partial set throws on next access.
BANK_API_CLIENT_ID=""
BANK_API_CLIENT_SECRET=""
BANK_API_BASE_URL=""

# Tier-0 paper-trading agent (ad hoc) — the shared secret the local
# FastAPI trading service (~/paper-trader) signs its trade receipts with.
# src/app/api/webhooks/trades/route.ts verifies an HMAC-SHA256 digest over
# `<timestamp>.<raw body>` against this, in constant time, before parsing
# anything. Must match WEBHOOK_SECRET in that service's own .env.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=""

# Which account a signed trade receipt (and its scenario metrics) is
# booked against. Not a secret — the receipt's signature is what
# authorizes the write — but deliberately server-side config rather than
# a body field, so one leaked secret can't be aimed at an arbitrary
# account. Prefer the EMAIL: a real account's email is stable, whereas a
# raw user id changes on every `npm run db:seed` (each re-seed mints a
# fresh demo row) and then fails every webhook. `PAPER_TRADING_USER_ID`
# is still honoured as a legacy fallback when the email is unset. The
# dashboard's "AI Engine" badge shows "trader account not linked" when
# neither resolves to a real row.
PAPER_TRADING_USER_EMAIL=""
PAPER_TRADING_USER_ID=""

# Not a secret — the Tier-0 paper-trading agent's FastAPI origin, the ONE
# place it's named: the dashboard health badge, the Agent Activity page's
# telemetry feed (proxied server-side — the browser never contacts the
# agent), and the emergency-halt forward all derive from it. Defaults to
# a locally-run `uvicorn main:app --port 8000` in ~/paper-trader; a hosted
# deployment sets it to that service's origin, e.g.
# https://paper-trader-juwa.onrender.com. (`PAPER_TRADER_HEALTH_URL`
# optionally overrides just the health probe; otherwise it's
# ${PAPER_TRADER_SERVICE_URL}/health.)
PAPER_TRADER_SERVICE_URL=""

# Not a secret, but security-relevant: shows a "Demo Login" button on
# /login that auto-fills and submits the demo credentials
# (src/lib/demo-credentials.ts) with one tap — built for live demos
# (e.g. a trade-show booth), never for a real deployment. NEXT_PUBLIC_-
# prefixed, so it's baked into the client bundle at build time. MUST be
# unset (or "false") for the real production deploy — only set to "true"
# in a separate demo/preview build. Leave unset for ordinary local dev.
#
# When "true", `npm run db:seed` ALSO creates the demo row already
# claimed with that password, so the button works on a fresh database.
# The trade-off: in demo mode a new registration gets an empty account
# instead of inheriting the seeded ledger (that inherit-on-first-
# registration behaviour, AGENTS.md §3ff, only applies to an UNCLAIMED
# demo row — i.e. with this flag off).
NEXT_PUBLIC_DEMO_MODE=""
