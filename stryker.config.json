{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.mts",
    "related": false
  },
  "reporters": ["html", "clear-text", "progress"],
  "mutate": [
    "src/lib/money.ts",
    "src/lib/apr.ts",
    "src/lib/stats.ts",
    "src/lib/debt-math.ts",
    "src/lib/cash-flow-forecast.ts",
    "src/lib/recurring-detection.ts"
  ],
  "coverageAnalysis": "all",
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 60
  }
}
